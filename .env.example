# Variables de Entorno de Ejemplo para VetCare Pro
# Copiar este archivo a .env y configurar las variables reales

# Base de Datos SQL Server
SA_PASSWORD=TuPasswordSeguro123!
DB_CONNECTION=Server=database;Database=VeterinariaDb;User Id=sa;Password=TuPasswordSeguro123!;TrustServerCertificate=False;Encrypt=True

# JWT Authentication (Mínimo 32 caracteres)
JWT_KEY=TuClaveSecretaJWT_Minimo32CaracteresDeEntropia!
JWT_ISSUER=VeterinariaAPI
JWT_AUDIENCE=VeterinariaApp
JWT_EXPIRY_MINUTES=1440

# Configuración de Producción
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_HOSTS=app.vetcarepro.com
CORS_ALLOWED_ORIGINS=https://app.vetcarepro.com,https://portal.vetcarepro.com
