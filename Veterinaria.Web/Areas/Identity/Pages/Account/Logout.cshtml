@page
@model Veterinaria.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Cerrar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>@ViewData["Title"]</h4>
            </div>
            <div class="card-body text-center">
                <p class="lead mb-4">Su sesión ha sido cerrada exitosamente.</p>
                <a asp-page="/Account/Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión Nuevamente
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-house me-2"></i>Ir al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
