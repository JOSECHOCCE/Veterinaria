@model X.PagedList.IPagedList<Veterinaria.Web.Controllers.VeterinarioConCitasViewModel>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Veterinarios";
    var especialidades = ViewBag.Especialidades as List<string> ?? new List<string>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-person-badge"></i> Veterinarios</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Veterinario
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="@ViewBag.CurrentFilter" 
                               class="form-control" placeholder="Buscar por nombre o email..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="especialidad" class="form-select">
                        <option value="">-- Todas las especialidades --</option>
                        @foreach (var esp in especialidades)
                        {
                            <option value="@esp" selected="@(ViewBag.CurrentEspecialidad == esp)">@esp</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de veterinarios -->
    <div class="card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="text-muted mt-3">No se encontraron veterinarios.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Especialidad</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Horario</th>
                                <th class="text-center">Citas esta semana</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var vet = item.Veterinario;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-2" 
                                                 style="width: 40px; height: 40px;">
                                                <i class="bi bi-person-badge text-white"></i>
                                            </div>
                                            <strong>@vet.Nombre</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(vet.Especialidad))
                                        {
                                            <span class="badge bg-info">@vet.Especialidad</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">General</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(vet.Email))
                                        {
                                            <a href="mailto:@vet.Email">@vet.Email</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(vet.Telefono ?? "-")</td>
                                    <td>
                                        <i class="bi bi-clock"></i>
                                        @vet.HorarioInicio.ToString(@"hh\:mm") - @vet.HorarioFin.ToString(@"hh\:mm")
                                    </td>
                                    <td class="text-center">
                                        @if (item.CitasEstaSemana > 0)
                                        {
                                            <span class="badge bg-primary rounded-pill">@item.CitasEstaSemana</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">0</span>
                                        }
                                    </td>
                                    <td>
                                        @if (vet.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@vet.Id" 
                                               class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@vet.Id" 
                                               class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@vet.Id" 
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount veterinarios
                    </div>
                    <nav>
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.CurrentFilter, especialidad = ViewBag.CurrentEspecialidad }),
                            new PagedListRenderOptions
                            {
                                LiElementClasses = new[] { "page-item" },
                                PageClasses = new[] { "page-link" },
                                UlElementClasses = new[] { "pagination", "mb-0" }
                            })
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
