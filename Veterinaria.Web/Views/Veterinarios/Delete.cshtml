@model Veterinaria.Web.Models.Dto.VeterinarioDto

@{
    ViewData["Title"] = $"Eliminar Dr. {Model.Nombre}";
    var tieneCitas = ViewBag.TieneCitas as bool? ?? false;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Veterinarios</a></li>
            <li class="breadcrumb-item active">Eliminar Dr. @Model.Nombre</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto mb-3" 
                             style="width: 100px; height: 100px;">
                            <i class="bi bi-person-badge text-white display-5"></i>
                        </div>
                        <h3>Dr. @Model.Nombre</h3>
                        @if (!string.IsNullOrEmpty(Model.Especialidad))
                        {
                            <span class="badge bg-info">@Model.Especialidad</span>
                        }
                    </div>

                    @if (tieneCitas)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-octagon"></i>
                            <strong>¡No se puede eliminar!</strong> Este veterinario tiene citas asociadas.
                            Debe reasignar o eliminar las citas primero.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>¡Atención!</strong> Está a punto de eliminar este veterinario. Esta acción no se puede deshacer.
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@(Model.Email ?? "No especificado")</dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@(Model.Telefono ?? "No especificado")</dd>

                        <dt class="col-sm-4">Horario</dt>
                        <dd class="col-sm-8">@Model.HorarioInicio.ToString(@"hh\:mm") - @Model.HorarioFin.ToString(@"hh\:mm")</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                        @if (!tieneCitas)
                        {
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Eliminar Veterinario
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
