@model Veterinaria.Web.Models.Dto.VeterinarioDto

@{
    ViewData["Title"] = $"Detalles de Dr. {Model.Nombre}";
    var citasEstaSemana = ViewBag.CitasEstaSemana as List<Veterinaria.Domain.Entities.Cita> ?? new List<Veterinaria.Domain.Entities.Cita>();
    var citasProximas = ViewBag.CitasProximas as List<Veterinaria.Domain.Entities.Cita> ?? new List<Veterinaria.Domain.Entities.Cita>();
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Veterinarios</a></li>
            <li class="breadcrumb-item active">Dr. @Model.Nombre</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Información del veterinario -->
        <div class="col-md-4">
            <div class="card">
                <div class="text-center pt-4">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto" 
                         style="width: 120px; height: 120px;">
                        <i class="bi bi-person-badge text-white display-4"></i>
                    </div>
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">Dr. @Model.Nombre</h3>
                    @if (!string.IsNullOrEmpty(Model.Especialidad))
                    {
                        <span class="badge bg-info fs-6">@Model.Especialidad</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Medicina General</span>
                    }
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-envelope"></i> Email</span>
                        <strong>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">No especificado</span>
                            }
                        </strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-telephone"></i> Teléfono</span>
                        <strong>@(Model.Telefono ?? "No especificado")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-clock"></i> Horario</span>
                        <strong>@Model.HorarioInicio.ToString(@"hh\:mm") - @Model.HorarioFin.ToString(@"hh\:mm")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span><i class="bi bi-check-circle"></i> Estado</span>
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </li>
                </ul>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-graph-up"></i> Esta Semana</h6>
                </div>
                <div class="card-body text-center">
                    <h2 class="display-4">@citasEstaSemana.Count</h2>
                    <p class="text-muted">Citas programadas</p>
                </div>
            </div>
        </div>

        <!-- Citas -->
        <div class="col-md-8">
            <!-- Citas de esta semana -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-week"></i> Citas de Esta Semana</h5>
                </div>
                <div class="card-body">
                    @if (citasEstaSemana.Count == 0)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-x display-4 text-muted"></i>
                            <p class="text-muted mt-3">No hay citas programadas para esta semana.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Fecha/Hora</th>
                                        <th>Mascota</th>
                                        <th>Servicio</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in citasEstaSemana)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@cita.FechaHora.ToString("dddd")</strong><br />
                                                <small>@cita.FechaHora.ToString("dd/MM HH:mm")</small>
                                            </td>
                                            <td>@cita.Mascota?.Nombre</td>
                                            <td>@cita.Servicio?.Nombre</td>
                                            <td>
                                                @{
                                                    var badgeClass = cita.Estado switch
                                                    {
                                                        "Completada" => "bg-success",
                                                        "Confirmada" => "bg-primary",
                                                        "EnProceso" => "bg-warning text-dark",
                                                        "Cancelada" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@cita.Estado</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Próximas citas -->
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Próximas Citas</h5>
                </div>
                <div class="card-body">
                    @if (citasProximas.Count == 0)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-x display-4 text-muted"></i>
                            <p class="text-muted mt-3">No hay citas próximas programadas.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var cita in citasProximas)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@cita.Mascota?.Nombre</strong> - @cita.Servicio?.Nombre
                                        <br />
                                        <small class="text-muted">
                                            <i class="bi bi-calendar"></i> @cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    @{
                                        var badge = cita.Estado switch
                                        {
                                            "Confirmada" => "bg-primary",
                                            "Pendiente" => "bg-secondary",
                                            _ => "bg-info"
                                        };
                                    }
                                    <span class="badge @badge">@cita.Estado</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>
</div>
