@using Microsoft.AspNetCore.Identity
@using Veterinaria.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetCare Pro</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#ffdcbe",
                        "surface-container-high": "#d5ecf8",
                        "background": "#f3faff",
                        "inverse-surface": "#1e333c",
                        "on-surface": "#071e27",
                        "on-tertiary-container": "#ffc388",
                        "on-secondary-fixed": "#002204",
                        "primary-fixed": "#d9e2ff",
                        "on-primary-fixed-variant": "#00419c",
                        "error": "#ba1a1a",
                        "on-tertiary": "#ffffff",
                        "outline": "#737784",
                        "surface-tint": "#1d59c1",
                        "on-primary-container": "#bcceff",
                        "on-secondary-container": "#00731e",
                        "secondary-container": "#91f78e",
                        "surface-container": "#dbf1fe",
                        "on-secondary-fixed-variant": "#005313",
                        "on-tertiary-fixed-variant": "#693c00",
                        "surface-dim": "#c7dde9",
                        "surface-container-low": "#e6f6ff",
                        "primary": "#003c90",
                        "on-tertiary-fixed": "#2c1600",
                        "on-primary-fixed": "#001945",
                        "tertiary": "#613600",
                        "on-background": "#071e27",
                        "surface-container-lowest": "#ffffff",
                        "inverse-primary": "#b0c6ff",
                        "secondary-fixed": "#94f990",
                        "surface-variant": "#cfe6f2",
                        "inverse-on-surface": "#dff4ff",
                        "primary-container": "#0f52ba",
                        "on-surface-variant": "#434653",
                        "on-error": "#ffffff",
                        "secondary-fixed-dim": "#78dc77",
                        "secondary": "#006e1c",
                        "tertiary-fixed-dim": "#ffb870",
                        "on-secondary": "#ffffff",
                        "tertiary-container": "#814b00",
                        "on-primary": "#ffffff",
                        "primary-fixed-dim": "#b0c6ff",
                        "surface": "#f3faff",
                        "on-error-container": "#93000a",
                        "outline-variant": "#c3c6d5",
                        "surface-container-highest": "#cfe6f2",
                        "surface-bright": "#f3faff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "sm": "12px",
                        "xs": "4px",
                        "md": "24px",
                        "margin": "32px",
                        "base": "8px",
                        "xl": "64px",
                        "gutter": "24px",
                        "lg": "40px"
                    },
                    "fontFamily": {
                        "label-md": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "headline-xl": ["Inter"],
                        "headline-lg": ["Inter"],
                        "body-md": ["Inter"]
                    },
                    "fontSize": {
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "500" }],
                        "headline-xl": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background text-on-background antialiased min-h-screen flex flex-col md:flex-row">
    
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- SideNavBar (Desktop) -->
        <nav class="hidden md:flex flex-col fixed left-0 top-0 h-full w-64 pt-20 pb-8 px-sm bg-surface-container-low border-r border-outline-variant z-30">
            <div class="mb-lg px-sm">
                <a asp-controller="Home" asp-action="Index" class="block">
                    <h1 class="text-headline-lg font-headline-lg text-primary flex items-center gap-2">
                        <span class="material-symbols-outlined text-3xl">pets</span>
                        VetCare Pro
                    </h1>
                </a>
                <p class="font-body-md text-body-md text-on-surface-variant">Clínica Veterinaria</p>
            </div>

            <div class="flex-1 space-y-xs overflow-y-auto">
                @if (User.IsInRole("Admin"))
                {
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined">dashboard</span>
                        Dashboard
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Citas" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Citas" asp-action="Index">
                        <span class="material-symbols-outlined">calendar_today</span>
                        Agenda
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Triage" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Triage" asp-action="Cola">
                        <span class="material-symbols-outlined">pending_actions</span>
                        Cola / Triage
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mascotas" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Mascotas" asp-action="Index">
                        <span class="material-symbols-outlined">pets</span>
                        Mascotas
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HistorialesClinicos" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="HistorialesClinicos" asp-action="Index">
                        <span class="material-symbols-outlined">medical_information</span>
                        Historiales Clínicos
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Clientes" asp-action="Index">
                        <span class="material-symbols-outlined">group</span>
                        Clientes
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pagos" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Pagos" asp-action="Index">
                        <span class="material-symbols-outlined">payments</span>
                        Pagos
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Consentimientos" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Consentimientos" asp-action="Index">
                        <span class="material-symbols-outlined">draw</span>
                        Consentimientos
                    </a>
                }
                else
                {
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Citas" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Citas" asp-action="Index">
                        <span class="material-symbols-outlined">calendar_today</span>
                        Mis Citas
                    </a>
                    <a class="flex items-center gap-sm px-md py-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mascotas" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-high") transition-all rounded-full font-label-md text-label-md" asp-controller="Mascotas" asp-action="Index">
                        <span class="material-symbols-outlined">pets</span>
                        Mis Mascotas
                    </a>
                }
            </div>

            <div class="mt-auto pt-md space-y-xs border-t border-outline-variant">
                <form class="w-full" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="w-full flex items-center gap-sm px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-all rounded-full font-label-md text-label-md">
                        <span class="material-symbols-outlined">logout</span>
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </nav>
    }

    <!-- TopAppBar -->
    <header class="fixed top-0 left-0 w-full z-40 flex justify-between items-center px-gutter h-16 bg-surface border-b border-outline-variant shadow-sm @(SignInManager.IsSignedIn(User) ? "md:pl-[calc(16rem+24px)]" : "px-4 md:px-8")">
        <div class="flex items-center gap-md">
            @if (SignInManager.IsSignedIn(User))
            {
                <h1 class="text-headline-md font-headline-md font-semibold text-primary md:hidden flex items-center gap-2">
                    <span class="material-symbols-outlined">pets</span> VetCare
                </h1>
                <div class="hidden md:block">
                    <h2 class="text-headline-md font-headline-md font-semibold text-on-surface">@ViewData["Title"]</h2>
                </div>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-3xl">pets</span>
                    <h1 class="text-headline-md font-headline-md font-semibold text-primary">VetCare Pro</h1>
                </a>
            }
        </div>
        <div class="flex items-center gap-sm text-primary">
            @if (SignInManager.IsSignedIn(User))
            {
                @if (!User.IsInRole("Admin"))
                {
                    <button class="p-base rounded-full hover:bg-surface-container-high transition-colors relative">
                        <span class="material-symbols-outlined">notifications</span>
                        <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-error rounded-full border-2 border-surface"></span>
                    </button>
                }
                
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Triage" asp-action="Create" class="p-base rounded-full hover:bg-surface-container-high transition-colors text-error" title="Nueva Emergencia">
                        <span class="material-symbols-outlined">emergency</span>
                    </a>
                }
                
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="p-base rounded-full hover:bg-surface-container-high transition-colors" title="Perfil">
                    <span class="material-symbols-outlined">account_circle</span>
                </a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="text-label-md font-label-md px-md py-sm text-primary hover:bg-primary-container rounded-full transition-colors">Iniciar Sesión</a>
            }
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 mt-16 @(SignInManager.IsSignedIn(User) ? "md:ml-64" : "") p-gutter lg:p-lg pb-24 md:pb-lg overflow-y-auto">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Configuración de Toastr -->
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "5000",
            "extendedTimeOut": "2000"
        };
        
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Success"]?.ToString()?.Replace("'", "\\'"))');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Error"]?.ToString()?.Replace("'", "\\'"))');</text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
