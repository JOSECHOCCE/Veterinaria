@model X.PagedList.IPagedList<Veterinaria.Web.Models.Dto.ServicioDto>
@using X.PagedList.Mvc.Core
@using Veterinaria.Web.Controllers

@{
    ViewData["Title"] = "Servicios";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-clipboard-pulse"></i> Servicios</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Servicio
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="@ViewBag.CurrentFilter" 
                               class="form-control" placeholder="Buscar por nombre o descripción..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-2">
                        <input type="checkbox" name="mostrarInactivos" value="true" 
                               class="form-check-input" id="mostrarInactivos"
                               @(ViewBag.MostrarInactivos == true ? "checked" : "") />
                        <label class="form-check-label" for="mostrarInactivos">
                            Mostrar inactivos
                        </label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary me-2">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de servicios -->
    <div class="card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="text-muted mt-3">No se encontraron servicios.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Servicio</th>
                                <th>Descripción</th>
                                <th class="text-center">Duración</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var servicio in Model)
                            {
                                <tr class="@(!servicio.Activo ? "table-secondary" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-success d-flex align-items-center justify-content-center me-2" 
                                                 style="width: 40px; height: 40px;">
                                                <i class="bi bi-clipboard-pulse text-white"></i>
                                            </div>
                                            <strong>@servicio.Nombre</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(servicio.Descripcion))
                                        {
                                            <span class="text-muted">
                                                @(servicio.Descripcion.Length > 50 
                                                    ? servicio.Descripcion.Substring(0, 50) + "..." 
                                                    : servicio.Descripcion)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">
                                            <i class="bi bi-clock"></i>
                                            @ServiciosController.FormatearDuracion(servicio.DuracionMinutos)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-success">@servicio.Precio.ToString("C")</strong>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleActivo" asp-route-id="@servicio.Id" method="post" class="d-inline">
                                            @if (servicio.Activo)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success" title="Clic para desactivar">
                                                    <i class="bi bi-check-circle"></i> Activo
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-secondary" title="Clic para activar">
                                                    <i class="bi bi-x-circle"></i> Inactivo
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@servicio.Id" 
                                               class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@servicio.Id" 
                                               class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@servicio.Id" 
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount servicios
                    </div>
                    <nav>
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.CurrentFilter, mostrarInactivos = ViewBag.MostrarInactivos }),
                            new PagedListRenderOptions
                            {
                                LiElementClasses = new[] { "page-item" },
                                PageClasses = new[] { "page-link" },
                                UlElementClasses = new[] { "pagination", "mb-0" }
                            })
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
