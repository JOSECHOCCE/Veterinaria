@model Veterinaria.Web.Models.Dto.ServicioDto
@using Veterinaria.Web.Controllers

@{
    ViewData["Title"] = $"Detalles de {Model.Nombre}";
    var totalCitas = ViewBag.TotalCitas as int? ?? 0;
    var citasCompletadas = ViewBag.CitasCompletadas as int? ?? 0;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Servicios</a></li>
            <li class="breadcrumb-item active">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Información del servicio -->
        <div class="col-md-6">
            <div class="card">
                <div class="text-center pt-4">
                    <div class="rounded-circle bg-success d-flex align-items-center justify-content-center mx-auto" 
                         style="width: 120px; height: 120px;">
                        <i class="bi bi-clipboard-pulse text-white display-4"></i>
                    </div>
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">@Model.Nombre</h3>
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success fs-6">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Inactivo</span>
                    }
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong><i class="bi bi-text-paragraph"></i> Descripción</strong>
                        <p class="mb-0 mt-2 text-muted">
                            @(Model.Descripcion ?? "Sin descripción")
                        </p>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-clock"></i> Duración</span>
                        <span class="badge bg-info fs-6">
                            @ServiciosController.FormatearDuracion(Model.DuracionMinutos)
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-currency-dollar"></i> Precio</span>
                        <span class="fs-4 text-success fw-bold">@Model.Precio.ToString("C")</span>
                    </li>
                </ul>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estadísticas -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Estadísticas</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border rounded p-4">
                                <h2 class="display-4 text-primary">@totalCitas</h2>
                                <p class="text-muted mb-0">Total de Citas</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-4">
                                <h2 class="display-4 text-success">@citasCompletadas</h2>
                                <p class="text-muted mb-0">Completadas</p>
                            </div>
                        </div>
                    </div>

                    @if (totalCitas > 0)
                    {
                        <div class="mt-4">
                            <label class="form-label">Tasa de completado</label>
                            <div class="progress" style="height: 25px;">
                                @{
                                    var porcentaje = totalCitas > 0 ? (citasCompletadas * 100 / totalCitas) : 0;
                                }
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: @porcentaje%;" 
                                     aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                                    @porcentaje%
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6>Ingresos estimados</h6>
                            <p class="fs-3 text-success fw-bold mb-0">
                                @((Model.Precio * citasCompletadas).ToString("C"))
                            </p>
                            <small class="text-muted">Basado en citas completadas</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>
</div>
