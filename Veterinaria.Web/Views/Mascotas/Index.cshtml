@model X.PagedList.IPagedList<Veterinaria.Web.Models.Dto.MascotaDto>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Pacientes (Mascotas)";
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Gestión del registro de pacientes y expedientes clínicos</p>
    </div>
    <a asp-action="Create" class="flex items-center gap-sm bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm text-decoration-none">
        <span class="material-symbols-outlined">add_circle</span>
        Nuevo Paciente
    </a>
</div>

<!-- Búsqueda -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm mb-lg p-md">
    <form asp-action="Index" method="get" class="flex flex-col md:flex-row gap-md items-end">
        <div class="flex-1 w-full">
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Búsqueda rápida</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input type="text" name="q" value="@ViewBag.CurrentFilter" class="w-full bg-surface border border-outline-variant rounded-md pl-10 pr-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Buscar por nombre o especie..." />
            </div>
        </div>
        <div class="w-full md:w-auto flex gap-2">
            <button type="submit" class="flex-1 md:flex-none bg-surface-variant text-on-surface px-xl py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-high transition-colors">Buscar</button>
            <a asp-action="Index" class="flex-1 md:flex-none bg-surface text-on-surface border border-outline-variant px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-low transition-colors text-center">Limpiar</a>
        </div>
    </form>
</div>

<!-- Tabla de mascotas -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm opacity-50">pets</span>
            <p class="font-headline-md text-headline-md">No se encontraron pacientes registrados.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="p-4 font-label-md text-label-md text-on-surface w-16">Foto</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Paciente</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Especie & Raza</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Edad</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Propietario</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var mascota in Model)
                    {
                        var especie = (mascota.Especie ?? string.Empty).Trim().ToLowerInvariant();
                        var fotoFallback = especie.Contains("gato")
                            ? "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=128&h=128&q=80"
                            : "https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=128&h=128&q=80";
                        var foto = string.IsNullOrWhiteSpace(mascota.FotoUrl) ? fotoFallback : mascota.FotoUrl;
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4 text-center">
                                <img src="@foto" alt="@mascota.Nombre" class="w-10 h-10 rounded-full object-cover border border-outline-variant" />
                            </td>
                            <td class="p-4">
                                <p class="font-body-md text-body-md text-on-surface font-semibold">@mascota.Nombre</p>
                            </td>
                            <td class="p-4">
                                <span class="font-label-sm text-label-sm text-on-secondary-container bg-secondary-container px-2 py-1 rounded-full inline-block mb-1">@mascota.Especie</span>
                                <p class="text-xs text-on-surface-variant">@(mascota.Raza ?? "Sin raza especificada")</p>
                            </td>
                            <td class="p-4">
                                <p class="font-body-md text-body-md text-on-surface">@(mascota.Edad.HasValue ? $"{mascota.Edad} años" : "N/D")</p>
                            </td>
                            <td class="p-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-on-surface-variant text-sm">person</span>
                                    <p class="font-body-md text-body-md text-on-surface">@(mascota.UsuarioNombre ?? "Desconocido")</p>
                                </div>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@mascota.Id" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Ver ficha">
                                        <span class="material-symbols-outlined text-lg">medical_information</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@mascota.Id" class="text-tertiary hover:bg-tertiary-container p-2 rounded-full transition-colors" title="Editar">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@mascota.Id" class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Eliminar">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div class="bg-surface-container-low p-md border-t border-outline-variant flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-on-surface-variant">
                Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount pacientes
            </div>
            <div>
                <style>
                    .pagination { display: flex; list-style: none; gap: 4px; margin: 0; padding: 0; }
                    .page-item .page-link { padding: 4px 12px; border-radius: 4px; border: 1px solid #c3c6d5; color: #071e27; text-decoration: none; font-size: 14px; background: #f3faff; }
                    .page-item.active .page-link { background: #003c90; color: #ffffff; border-color: #003c90; }
                    .page-item.disabled .page-link { opacity: 0.5; pointer-events: none; }
                    .page-item:not(.active):not(.disabled) .page-link:hover { background: #cfe6f2; }
                </style>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.CurrentFilter }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" },
                        UlElementClasses = new[] { "pagination" }
                    })
            </div>
        </div>
    }
</div>
