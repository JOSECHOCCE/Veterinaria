@model Veterinaria.Web.Models.Dto.MascotaDto

@{
    ViewData["Title"] = "Nuevo Paciente";
}

<div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Complete la ficha de registro del nuevo paciente.</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="bg-primary/5 border-b border-outline-variant p-md">
            <h3 class="font-headline-sm text-headline-sm text-primary flex items-center gap-2">
                <span class="material-symbols-outlined">pets</span>
                Registrar Nueva Mascota
            </h3>
        </div>
        <div class="p-lg">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-error mb-4 bg-error-container p-3 rounded-md border border-error"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-md">
                    <div>
                        <label asp-for="Nombre" class="block font-label-md text-label-md text-on-surface mb-xs">Nombre *</label>
                        <input asp-for="Nombre" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Nombre de la mascota" />
                        <span asp-validation-for="Nombre" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="Especie" class="block font-label-md text-label-md text-on-surface mb-xs">Especie *</label>
                        <select asp-for="Especie" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                            <option value="">-- Seleccione --</option>
                            <option value="Perro">Perro</option>
                            <option value="Gato">Gato</option>
                            <option value="Ave">Ave</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Especie" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="Raza" class="block font-label-md text-label-md text-on-surface mb-xs">Raza</label>
                        <input asp-for="Raza" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Ej: Golden Retriever" />
                        <span asp-validation-for="Raza" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="Color" class="block font-label-md text-label-md text-on-surface mb-xs">Color</label>
                        <input asp-for="Color" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Color del pelaje" />
                        <span asp-validation-for="Color" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="FechaNacimiento" class="block font-label-md text-label-md text-on-surface mb-xs">Fecha de Nacimiento</label>
                        <input asp-for="FechaNacimiento" type="date" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="FechaNacimiento" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="Peso" class="block font-label-md text-label-md text-on-surface mb-xs">Peso (kg)</label>
                        <div class="flex">
                            <input asp-for="Peso" type="number" step="0.01" class="flex-1 bg-surface border border-outline-variant rounded-l-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="0.00" />
                            <span class="bg-surface-container-high border border-l-0 border-outline-variant rounded-r-md px-3 py-2 text-on-surface-variant font-label-md text-label-md">kg</span>
                        </div>
                        <span asp-validation-for="Peso" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="UsuarioId" class="block font-label-md text-label-md text-on-surface mb-xs">Propietario *</label>
                        <select asp-for="UsuarioId" asp-items="@ViewBag.Usuarios" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                            <option value="">-- Seleccione propietario --</option>
                        </select>
                        <span asp-validation-for="UsuarioId" class="text-error text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="FotoUrl" class="block font-label-md text-label-md text-on-surface mb-xs">URL de Foto</label>
                        <input asp-for="FotoUrl" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="https://ejemplo.com/foto.jpg" />
                        <span asp-validation-for="FotoUrl" class="text-error text-xs"></span>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-md border-t border-outline-variant">
                    <a asp-action="Index" class="px-md py-sm rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">Cancelar</a>
                    <button type="submit" class="bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">save</span>
                        Guardar Mascota
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
