@model Veterinaria.Web.Models.Dto.MascotaDto

@{
    ViewData["Title"] = "Nueva Mascota";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Mascotas</a></li>
            <li class="breadcrumb-item active">Nueva Mascota</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Registrar Nueva Mascota</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre de la mascota" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Especie" class="form-label"></label>
                                <select asp-for="Especie" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    <option value="Perro">Perro</option>
                                    <option value="Gato">Gato</option>
                                    <option value="Ave">Ave</option>
                                    <option value="Otro">Otro</option>
                                </select>
                                <span asp-validation-for="Especie" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Raza" class="form-label"></label>
                                <input asp-for="Raza" class="form-control" placeholder="Raza" />
                                <span asp-validation-for="Raza" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Color" class="form-label"></label>
                                <input asp-for="Color" class="form-control" placeholder="Color" />
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaNacimiento" class="form-label"></label>
                                <input asp-for="FechaNacimiento" type="date" class="form-control" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Peso" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Peso" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <span asp-validation-for="Peso" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UsuarioId" class="form-label">Propietario</label>
                                <select asp-for="UsuarioId" asp-items="@ViewBag.Usuarios" class="form-select">
                                    <option value="">-- Seleccione propietario --</option>
                                </select>
                                <span asp-validation-for="UsuarioId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FotoUrl" class="form-label"></label>
                                <input asp-for="FotoUrl" class="form-control" placeholder="URL de la foto" />
                                <span asp-validation-for="FotoUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Guardar Mascota
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
