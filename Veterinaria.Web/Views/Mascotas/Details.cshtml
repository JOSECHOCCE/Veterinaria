@model Veterinaria.Web.Models.Dto.MascotaDto
@{
    ViewData["Title"] = $"Ficha de {Model.Nombre}";
    var citas = ViewBag.Citas as List<Veterinaria.Domain.Entities.Cita> ?? new List<Veterinaria.Domain.Entities.Cita>();
}

<div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Expediente completo del paciente</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-md">
        <!-- Ficha del paciente -->
        <div class="lg:col-span-1">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="p-lg text-center">
                    @{
                        var especie = (Model.Especie ?? string.Empty).Trim().ToLowerInvariant();
                        var fotoFallback = especie.Contains("gato")
                            ? "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=256&h=256&q=80"
                            : "https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=256&h=256&q=80";
                        var foto = string.IsNullOrWhiteSpace(Model.FotoUrl) ? fotoFallback : Model.FotoUrl;
                    }
                    <img src="@foto" alt="@Model.Nombre" class="w-28 h-28 rounded-full object-cover border-2 border-outline-variant mx-auto mb-3" />
                    <h3 class="font-headline-lg text-headline-lg text-on-surface">@Model.Nombre</h3>
                    <span class="font-label-sm text-label-sm text-on-secondary-container bg-secondary-container px-3 py-1 rounded-full">@Model.Especie</span>
                </div>
                <div class="border-t border-outline-variant divide-y divide-outline-variant text-sm">
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">tag</span> Raza</span><strong>@(Model.Raza ?? "N/A")</strong></div>
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">cake</span> Edad</span><strong>@(Model.Edad.HasValue ? $"{Model.Edad} años" : "N/A")</strong></div>
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">event</span> Nacimiento</span><strong>@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "N/A")</strong></div>
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">monitor_weight</span> Peso</span><strong>@(Model.Peso.HasValue ? $"{Model.Peso} kg" : "N/A")</strong></div>
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">palette</span> Color</span><strong>@(Model.Color ?? "N/A")</strong></div>
                    <div class="flex justify-between p-3 px-lg"><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">person</span> Propietario</span><strong>@(Model.UsuarioNombre ?? "N/A")</strong></div>
                </div>
                <div class="p-md space-y-2 border-t border-outline-variant">
                    <a asp-action="Index" asp-controller="HistorialesClinicos" asp-route-mascotaId="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors text-decoration-none">
                        <span class="material-symbols-outlined text-sm">medical_information</span> Ver Historial Clínico
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-surface text-tertiary border border-outline-variant px-md py-sm rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-colors text-decoration-none">
                        <span class="material-symbols-outlined text-sm">edit</span> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-surface text-error border border-outline-variant px-md py-sm rounded-full font-label-md text-label-md hover:bg-error-container transition-colors text-decoration-none">
                        <span class="material-symbols-outlined text-sm">delete</span> Eliminar
                    </a>
                </div>
            </div>
        </div>

        <!-- Historial de citas -->
        <div class="lg:col-span-2">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-surface-container-low p-md border-b border-outline-variant flex justify-between items-center">
                    <h3 class="font-headline-md text-headline-md text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">calendar_month</span> Historial de Citas
                    </h3>
                    <a asp-controller="Citas" asp-action="Create" asp-route-mascotaId="@Model.Id" class="flex items-center gap-1 bg-primary text-on-primary px-3 py-1.5 rounded-full font-label-md text-label-md hover:bg-primary/90 text-decoration-none">
                        <span class="material-symbols-outlined text-sm">add</span> Nueva Cita
                    </a>
                </div>
                @if (citas.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
                        <span class="material-symbols-outlined text-5xl mb-sm opacity-50">event_busy</span>
                        <p>No hay citas registradas para este paciente.</p>
                    </div>
                }
                else
                {
                    <div class="divide-y divide-outline-variant">
                        @foreach (var cita in citas)
                        {
                            var badgeClass = cita.Estado switch
                            {
                                "Completada" => "bg-secondary-container text-on-secondary-container",
                                "Confirmada" => "bg-primary-container text-on-primary-container",
                                "EnProceso" => "bg-tertiary-container text-on-tertiary-container",
                                "Cancelada" => "bg-error-container text-on-error-container",
                                _ => "bg-surface-variant text-on-surface"
                            };
                            <div class="flex items-center justify-between p-md hover:bg-surface-container-low transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="text-center w-14">
                                        <p class="font-body-md text-body-md text-on-surface font-bold">@cita.FechaHora.ToString("dd/MM")</p>
                                        <p class="text-xs text-on-surface-variant">@cita.FechaHora.ToString("HH:mm")</p>
                                    </div>
                                    <div>
                                        <p class="font-body-md text-body-md text-on-surface font-semibold">@cita.Servicio?.Nombre</p>
                                        <p class="text-xs text-on-surface-variant">Dr. @cita.Veterinario?.Nombre</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-label-sm text-label-sm px-2 py-1 rounded-full @badgeClass">@cita.Estado</span>
                                    <a asp-controller="Citas" asp-action="Details" asp-route-id="@cita.Id" class="text-primary hover:bg-primary-container p-1.5 rounded-full transition-colors">
                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
