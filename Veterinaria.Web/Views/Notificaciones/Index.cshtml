@model List<Veterinaria.Domain.Entities.Notificacion>
@{
    ViewData["Title"] = "Mis Notificaciones";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="bi bi-bell-fill me-2"></i>Mis Notificaciones
                            </h4>
                            <small class="text-white-50">
                                Tienes @ViewBag.NoLeidasCount notificación(es) sin leer
                            </small>
                        </div>
                        @if(Model.Any(n => !n.Leida))
                        {
                            <button id="btnMarcarTodasLeidas" class="btn btn-light btn-sm">
                                <i class="bi bi-check-all me-1"></i> Marcar todas como leídas
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    @if(!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-bell-slash display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No tienes notificaciones</h5>
                            <p class="text-muted">Las notificaciones sobre tus citas aparecerán aquí</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach(var notificacion in Model)
                            {
                                var bgClass = notificacion.Leida ? "" : "bg-light";
                                var tipoClass = notificacion.Tipo switch 
                                {
                                    "Success" => "text-success",
                                    "Warning" => "text-warning",
                                    "Error" => "text-danger",
                                    _ => "text-info"
                                };
                                var icono = notificacion.Icono ?? (notificacion.Tipo switch 
                                {
                                    "Success" => "bi-check-circle-fill",
                                    "Warning" => "bi-exclamation-triangle-fill",
                                    "Error" => "bi-x-circle-fill",
                                    _ => "bi-info-circle-fill"
                                });
                                
                                <div class="list-group-item list-group-item-action @bgClass border-start-0 border-end-0" 
                                     data-notificacion-id="@notificacion.Id">
                                    <div class="d-flex w-100 align-items-start">
                                        <div class="me-3">
                                            <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" 
                                                 style="width: 48px; height: 48px;">
                                                <i class="bi @icono @tipoClass fs-4"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex w-100 justify-content-between align-items-start mb-1">
                                                <h6 class="mb-0 @(notificacion.Leida ? "" : "fw-bold")">
                                                    @notificacion.Titulo
                                                    @if(!notificacion.Leida)
                                                    {
                                                        <span class="badge bg-primary rounded-pill ms-2">Nueva</span>
                                                    }
                                                </h6>
                                                <small class="text-muted">
                                                    @ObtenerTiempoRelativo(notificacion.FechaCreacion)
                                                </small>
                                            </div>
                                            <p class="mb-2 text-muted">@notificacion.Mensaje</p>
                                            <div class="d-flex gap-2">
                                                @if(!string.IsNullOrEmpty(notificacion.UrlAccion))
                                                {
                                                    <a href="@notificacion.UrlAccion" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye me-1"></i> Ver detalles
                                                    </a>
                                                }
                                                @if(!notificacion.Leida)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary btn-marcar-leida" 
                                                            data-id="@notificacion.Id">
                                                        <i class="bi bi-check me-1"></i> Marcar como leída
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger btn-eliminar" 
                                                        data-id="@notificacion.Id">
                                                    <i class="bi bi-trash me-1"></i> Eliminar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string ObtenerTiempoRelativo(DateTime fecha)
    {
        var diferencia = DateTime.Now - fecha;

        if (diferencia.TotalMinutes < 1) return "Ahora mismo";
        if (diferencia.TotalMinutes < 60) return $"Hace {(int)diferencia.TotalMinutes} min";
        if (diferencia.TotalHours < 24) return $"Hace {(int)diferencia.TotalHours} horas";
        if (diferencia.TotalDays < 7) return $"Hace {(int)diferencia.TotalDays} días";
        
        return fecha.ToString("dd/MM/yyyy HH:mm");
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Marcar como leída
            $('.btn-marcar-leida').click(function() {
                var btn = $(this);
                var id = btn.data('id');
                var item = btn.closest('[data-notificacion-id]');
                
                $.post('/Notificaciones/MarcarLeida/' + id, function(response) {
                    if (response.success) {
                        item.removeClass('bg-light');
                        item.find('.badge').remove();
                        item.find('h6').removeClass('fw-bold');
                        btn.remove();
                        toastr.success('Notificación marcada como leída');
                        actualizarContador();
                    }
                });
            });

            // Marcar todas como leídas
            $('#btnMarcarTodasLeidas').click(function() {
                var btn = $(this);
                btn.prop('disabled', true);
                
                $.post('/Notificaciones/MarcarTodasLeidas', function(response) {
                    if (response.success) {
                        $('.list-group-item').removeClass('bg-light');
                        $('.badge').remove();
                        $('h6').removeClass('fw-bold');
                        $('.btn-marcar-leida').remove();
                        btn.remove();
                        toastr.success('Todas las notificaciones marcadas como leídas');
                        actualizarContador();
                    }
                }).always(function() {
                    btn.prop('disabled', false);
                });
            });

            // Eliminar notificación
            $('.btn-eliminar').click(function() {
                var btn = $(this);
                var id = btn.data('id');
                var item = btn.closest('[data-notificacion-id]');
                
                if (confirm('¿Estás seguro de eliminar esta notificación?')) {
                    $.ajax({
                        url: '/Notificaciones/Eliminar/' + id,
                        type: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        success: function(response) {
                            if (response.success) {
                                item.fadeOut(300, function() {
                                    $(this).remove();
                                    if ($('.list-group-item').length === 0) {
                                        location.reload();
                                    }
                                });
                                toastr.success('Notificación eliminada');
                                actualizarContador();
                            }
                        }
                    });
                }
            });

            function actualizarContador() {
                $.get('/Notificaciones/ObtenerNoLeidas', function(response) {
                    var count = response.count;
                    $('#notificacionCount').text(count);
                    if (count === 0) {
                        $('#notificacionBadge').hide();
                    }
                });
            }
        });
    </script>
}
