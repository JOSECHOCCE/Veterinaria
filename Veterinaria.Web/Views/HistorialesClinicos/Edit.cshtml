@model Veterinaria.Web.Models.Dto.HistorialClinicoDto

@{
    ViewData["Title"] = "Editar Historial Clínico";
    var cita = ViewBag.Cita as Veterinaria.Domain.Entities.Cita;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Información de la cita -->
            <div class="card shadow mb-4 border-info">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle"></i> Información de la Consulta
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <p class="mb-2">
                                <i class="bi bi-heart-pulse text-primary"></i>
                                <strong>Mascota:</strong><br />
                                <span class="fs-5">@cita?.Mascota?.Nombre</span><br />
                                <small class="text-muted">@cita?.Mascota?.Especie - @(cita?.Mascota?.Raza ?? "Sin raza")</small>
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="mb-2">
                                <i class="bi bi-person-badge text-info"></i>
                                <strong>Veterinario:</strong><br />
                                <span class="fs-5">@cita?.Veterinario?.Nombre</span><br />
                                <small class="text-muted">@cita?.Veterinario?.Especialidad</small>
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="mb-2">
                                <i class="bi bi-calendar3 text-warning"></i>
                                <strong>Fecha de la Cita:</strong><br />
                                <span class="fs-5">@cita?.FechaHora.ToString("dd/MM/yyyy")</span><br />
                                <small class="text-muted">@cita?.FechaHora.ToString("HH:mm") hrs</small>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Formulario de Edición -->
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Editar Ficha Médica
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CitaId" />
                        <input type="hidden" asp-for="FechaRegistro" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="Diagnostico" class="form-label">
                                <i class="bi bi-search text-primary"></i> Diagnóstico *
                            </label>
                            <textarea asp-for="Diagnostico" class="form-control form-control-lg" rows="5"></textarea>
                            <span asp-validation-for="Diagnostico" class="text-danger small"></span>
                            <div class="form-text">Máximo 1000 caracteres</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Tratamiento" class="form-label">
                                <i class="bi bi-bandaid text-success"></i> Tratamiento Indicado
                            </label>
                            <textarea asp-for="Tratamiento" class="form-control form-control-lg" rows="4"></textarea>
                            <span asp-validation-for="Tratamiento" class="text-danger small"></span>
                            <div class="form-text">Máximo 1000 caracteres</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Medicamentos" class="form-label">
                                <i class="bi bi-capsule text-warning"></i> Medicamentos Recetados
                            </label>
                            <textarea asp-for="Medicamentos" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Medicamentos" class="text-danger small"></span>
                            <div class="form-text">Máximo 500 caracteres</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Observaciones" class="form-label">
                                <i class="bi bi-chat-left-text text-secondary"></i> Observaciones Adicionales
                            </label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger small"></span>
                            <div class="form-text">Máximo 1000 caracteres</div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-citaId="@Model.CitaId" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
