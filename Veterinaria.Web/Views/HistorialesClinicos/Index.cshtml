@model X.PagedList.IPagedList<Veterinaria.Web.Models.Dto.HistorialClinicoDto>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Historial Clínico";
    var mascota = ViewBag.Mascota as Veterinaria.Domain.Entities.Mascota;
}

<div class="max-w-4xl mx-auto">
    <!-- Encabezado con información de la mascota -->
    <div class="bg-primary-container text-on-primary-container rounded-xl border border-outline-variant shadow-sm mb-xl overflow-hidden">
        <div class="p-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
            <div class="flex items-center gap-md">
                <div class="w-16 h-16 rounded-full bg-surface flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary text-3xl">pets</span>
                </div>
                <div>
                    <h3 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
                        @mascota?.Nombre
                    </h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">@mascota?.Especie • @(mascota?.Raza ?? "Sin raza especificada")</p>
                    <p class="font-body-sm text-body-sm opacity-80 flex items-center gap-1 mt-1">
                        <span class="material-symbols-outlined text-sm">person</span>
                        Propietario: @mascota?.Usuario?.Nombre
                    </p>
                </div>
            </div>
            <div class="flex flex-col items-end gap-2">
                @if (mascota?.FechaNacimiento != null)
                {
                    var edad = DateTime.Today.Year - mascota.FechaNacimiento.Value.Year;
                    <span class="font-label-md text-label-md bg-surface text-primary px-3 py-1 rounded-full">@edad años</span>
                }
                <a asp-action="Index" asp-controller="Mascotas" class="text-sm font-semibold hover:underline flex items-center gap-1 text-on-primary-container">
                    <span class="material-symbols-outlined text-sm">arrow_back</span> Volver a Mascotas
                </a>
            </div>
        </div>
    </div>

    <!-- Listado de historiales -->
    @if (Model.Count == 0)
    {
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm p-xl flex flex-col items-center justify-center text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm opacity-50">medical_information</span>
            <h4 class="font-headline-md text-headline-md text-on-surface">No hay registros clínicos</h4>
            <p class="font-body-md text-body-md">Este paciente aún no tiene consultas o tratamientos registrados.</p>
        </div>
    }
    else
    {
        <div class="space-y-md mb-lg">
            @foreach (var historial in Model)
            {
                <div class="bg-surface-container-lowest rounded-xl border-l-4 border-l-primary border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                    <div class="bg-surface-container-low p-md border-b border-outline-variant flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-xl">event</span>
                            <div>
                                <p class="font-body-md text-body-md text-on-surface font-semibold">@historial.FechaCita?.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
                                <p class="font-label-sm text-label-sm text-on-surface-variant">@historial.FechaCita?.ToString("HH:mm") hrs</p>
                            </div>
                        </div>
                        <a asp-action="Details" asp-route-citaId="@historial.CitaId" class="flex items-center gap-1 font-label-md text-label-md text-primary hover:bg-primary-container px-3 py-1.5 rounded-full transition-colors">
                            <span class="material-symbols-outlined text-sm">visibility</span> Ver Cita
                        </a>
                    </div>
                    <div class="p-md">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-md">
                            <div class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-secondary text-lg mt-0.5">stethoscope</span>
                                <div>
                                    <p class="font-label-xs text-label-xs text-on-surface-variant uppercase tracking-wider">Veterinario Tratante</p>
                                    <p class="font-body-md text-body-md text-on-surface">@historial.VeterinarioNombre</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-tertiary text-lg mt-0.5">medical_services</span>
                                <div>
                                    <p class="font-label-xs text-label-xs text-on-surface-variant uppercase tracking-wider">Servicio</p>
                                    <span class="font-label-sm text-label-sm text-on-tertiary-container bg-tertiary-container px-2 py-[2px] rounded-DEFAULT mt-1 inline-block">@historial.ServicioNombre</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="space-y-4 border-t border-outline-variant pt-4">
                            <div>
                                <h6 class="font-label-md text-label-md text-primary flex items-center gap-1 mb-1">
                                    <span class="material-symbols-outlined text-sm">search</span> Diagnóstico
                                </h6>
                                <p class="font-body-md text-body-md text-on-surface bg-surface-container p-3 rounded-lg border border-outline-variant">@historial.Diagnostico</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(historial.Tratamiento))
                            {
                                <div>
                                    <h6 class="font-label-md text-label-md text-secondary flex items-center gap-1 mb-1">
                                        <span class="material-symbols-outlined text-sm">healing</span> Tratamiento
                                    </h6>
                                    <p class="font-body-md text-body-md text-on-surface">@historial.Tratamiento</p>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(historial.Medicamentos))
                            {
                                <div>
                                    <h6 class="font-label-md text-label-md text-tertiary flex items-center gap-1 mb-1">
                                        <span class="material-symbols-outlined text-sm">medication</span> Medicamentos Prescritos
                                    </h6>
                                    <p class="font-body-md text-body-md text-on-surface">@historial.Medicamentos</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="bg-surface p-3 text-right border-t border-outline-variant rounded-b-xl">
                        <p class="text-xs text-on-surface-variant flex justify-end items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">history</span> 
                            Registrado: @historial.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-on-surface-variant">
                Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount registros
            </div>
            <div>
                <style>
                    .pagination { display: flex; list-style: none; gap: 4px; margin: 0; padding: 0; }
                    .page-item .page-link { padding: 4px 12px; border-radius: 4px; border: 1px solid #c3c6d5; color: #071e27; text-decoration: none; font-size: 14px; background: #f3faff; }
                    .page-item.active .page-link { background: #003c90; color: #ffffff; border-color: #003c90; }
                    .page-item.disabled .page-link { opacity: 0.5; pointer-events: none; }
                    .page-item:not(.active):not(.disabled) .page-link:hover { background: #cfe6f2; }
                </style>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { mascotaId = ViewBag.MascotaId, page }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" },
                        UlElementClasses = new[] { "pagination" }
                    })
            </div>
        </div>
    }
</div>
