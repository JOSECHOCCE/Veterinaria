@model Veterinaria.Web.Models.Dto.CitaDto
@{
    ViewData["Title"] = "Editar Cita";
}

<div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Actualice el estado de la cita.</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="bg-tertiary-container/20 border-b border-outline-variant p-md">
            <h3 class="font-headline-sm text-headline-sm text-tertiary flex items-center gap-2">
                <span class="material-symbols-outlined">edit_calendar</span>
                Editar Estado de Cita
            </h3>
        </div>
        <div class="p-lg">
            <!-- Info de la cita (solo lectura) -->
            <div class="bg-surface-container rounded-lg border border-outline-variant p-md mb-lg">
                <h5 class="font-label-md text-label-md text-on-surface font-semibold mb-3">Información de la Cita</h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">pets</span> Mascota:</span><strong class="block mt-0.5">@Model.MascotaNombre</strong></div>
                    <div><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">stethoscope</span> Veterinario:</span><strong class="block mt-0.5">@Model.VeterinarioNombre</strong></div>
                    <div><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">medical_services</span> Servicio:</span><strong class="block mt-0.5">@Model.ServicioNombre</strong></div>
                    <div><span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">schedule</span> Fecha:</span><strong class="block mt-0.5">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</strong></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Motivo))
                {
                    <div class="mt-3 text-sm"><span class="text-on-surface-variant">Motivo:</span><p class="mt-0.5">@Model.Motivo</p></div>
                }
            </div>

            <!-- Formulario de edición -->
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MascotaId" />
                <input type="hidden" asp-for="VeterinarioId" />
                <input type="hidden" asp-for="ServicioId" />
                <input type="hidden" asp-for="FechaHora" />
                <div asp-validation-summary="ModelOnly" class="text-error mb-4 bg-error-container p-3 rounded-md border border-error"></div>

                <div class="mb-md">
                    <label asp-for="Estado" class="block font-label-md text-label-md text-on-surface mb-xs">Estado de la Cita *</label>
                    <select asp-for="Estado" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" id="estadoSelect">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Confirmada">Confirmada</option>
                        <option value="EnProceso">En Proceso</option>
                        <option value="Completada">Completada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-error text-xs"></span>
                    <p class="text-xs text-on-surface-variant mt-1">Cambie el estado según el progreso de la cita</p>
                </div>

                <div class="mb-md">
                    <label asp-for="Motivo" class="block font-label-md text-label-md text-on-surface mb-xs">Motivo / Observaciones</label>
                    <textarea asp-for="Motivo" rows="3" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Actualice el motivo o agregue observaciones..."></textarea>
                    <span asp-validation-for="Motivo" class="text-error text-xs"></span>
                </div>

                <div id="alertaEstado" class="hidden bg-tertiary-container/20 border border-tertiary text-on-surface p-3 rounded-md mb-md text-sm">
                    <span id="alertaEstadoTexto"></span>
                </div>

                <div class="flex justify-end gap-3 pt-md border-t border-outline-variant">
                    <a asp-action="Index" class="px-md py-sm rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">Volver</a>
                    <button type="submit" class="bg-tertiary text-on-tertiary px-md py-sm rounded-full font-label-md text-label-md hover:opacity-90 transition-colors shadow-sm flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">save</span>
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Leyenda de estados -->
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm p-md mt-md">
        <h6 class="font-label-md text-label-md text-on-surface-variant mb-2">Estados disponibles:</h6>
        <div class="flex flex-wrap gap-2 text-xs">
            <span class="bg-surface-variant text-on-surface px-2 py-1 rounded-full">Pendiente — esperando confirmación</span>
            <span class="bg-primary-container text-on-primary-container px-2 py-1 rounded-full">Confirmada — lista para atención</span>
            <span class="bg-tertiary-container text-on-tertiary-container px-2 py-1 rounded-full">En Proceso — en atención</span>
            <span class="bg-secondary-container text-on-secondary-container px-2 py-1 rounded-full">Completada — genera historial</span>
            <span class="bg-error-container text-on-error-container px-2 py-1 rounded-full">Cancelada — cita anulada</span>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            const estadoInicial = '@Model.Estado';
            $('#estadoSelect').on('change', function() {
                const n = $(this).val(), a = $('#alertaEstado'), t = $('#alertaEstadoTexto');
                a.addClass('hidden');
                if (n === 'Completada') { a.removeClass('hidden'); t.text('Al marcar como Completada, se podrá crear un historial clínico.'); }
                else if (n === 'Cancelada') { a.removeClass('hidden'); t.text('Al cancelar la cita, no se podrá volver a activar.'); }
                else if (estadoInicial === 'Completada' && n !== 'Completada') { a.removeClass('hidden'); t.text('Cambiar el estado de una cita completada puede afectar el historial clínico.'); }
            });
            $('#estadoSelect').trigger('change');
        });
    </script>
}
