@model Veterinaria.Web.Models.Dto.CitaDto

@{
    ViewData["Title"] = "Detalle de Cita";
    var esAdmin = ViewBag.EsAdmin ?? false;
    var esPropietario = ViewBag.EsPropietario ?? false;
    var propietarioNombre = ViewBag.PropietarioNombre ?? "";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="bi bi-calendar-check"></i> @(esAdmin ? "Detalle de Cita" : "Mi Cita")
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a @(esAdmin ? "listado" : "mis citas")
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Estado en Tiempo Real (solo para usuarios) -->
            @if (!esAdmin)
            {
                <div class="card shadow mb-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-activity"></i> Estado de tu Cita
                            <small class="float-end" id="ultimaActualizacion" style="font-size: 0.8rem;"></small>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <span id="estadoBadge" class="badge fs-4" style="padding: 15px 30px;">
                                @Model.Estado
                            </span>
                        </div>
                        
                        <!-- Timeline de estados -->
                        <div class="timeline-horizontal mt-4">
                            <div class="timeline-item @(Model.Estado != "Cancelada" ? "active" : "")">
                                <div class="timeline-icon"><i class="bi bi-check-circle"></i></div>
                                <div class="timeline-content">Agendada</div>
                            </div>
                            <div class="timeline-item @(Model.Estado == "Confirmada" || Model.Estado == "EnProceso" || Model.Estado == "Completada" ? "active" : "")">
                                <div class="timeline-icon"><i class="bi bi-check2-circle"></i></div>
                                <div class="timeline-content">Confirmada</div>
                            </div>
                            <div class="timeline-item @(Model.Estado == "EnProceso" || Model.Estado == "Completada" ? "active" : "")">
                                <div class="timeline-icon"><i class="bi bi-gear"></i></div>
                                <div class="timeline-content">En Proceso</div>
                            </div>
                            <div class="timeline-item @(Model.Estado == "Completada" ? "active" : "")">
                                <div class="timeline-icon"><i class="bi bi-check-circle-fill"></i></div>
                                <div class="timeline-content">Completada</div>
                            </div>
                        </div>
                        
                        @if (Model.Estado == "Cancelada" || Model.Estado == "NoAsistio")
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Esta cita fue @(Model.Estado == "Cancelada" ? "cancelada" : "marcada como no asistida").</strong>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Información principal de la cita -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle"></i> Información de la Cita
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-muted">Datos de la Mascota</h5>
                            <hr />
                            <p>
                                <strong><i class="bi bi-heart-pulse"></i> Mascota:</strong><br />
                                <span class="fs-5">@Model.MascotaNombre</span>
                            </p>
                            @if (esAdmin)
                            {
                                <p>
                                    <strong><i class="bi bi-person"></i> Propietario:</strong><br />
                                    <span>@propietarioNombre</span>
                                </p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Datos del Servicio</h5>
                            <hr />
                            <p>
                                <strong><i class="bi bi-person-badge"></i> Veterinario:</strong><br />
                                <span class="fs-5">@Model.VeterinarioNombre</span>
                            </p>
                            <p>
                                <strong><i class="bi bi-clipboard-pulse"></i> Servicio:</strong><br />
                                <span class="badge bg-info fs-6">@Model.ServicioNombre</span>
                            </p>
                        </div>
                    </div>
                    
                    <hr />
                    
                    <div class="row">
                        <div class="col-md-4">
                            <p>
                                <strong><i class="bi bi-calendar3"></i> Fecha:</strong><br />
                                <span class="fs-5">@Model.FechaHora.ToString("dddd, dd 'de' MMMM 'de' yyyy")</span>
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p>
                                <strong><i class="bi bi-clock"></i> Hora:</strong><br />
                                <span class="fs-5">@Model.FechaHora.ToString("HH:mm")</span>
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p>
                                <strong><i class="bi bi-flag"></i> Estado:</strong><br />
                                @{
                                    var badgeClass = Model.Estado switch
                                    {
                                        "Completada" => "bg-success",
                                        "Confirmada" => "bg-primary",
                                        "EnProceso" => "bg-warning text-dark",
                                        "Cancelada" => "bg-danger",
                                        "NoAsistio" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass fs-6" id="estadoActual">@Model.Estado</span>
                            </p>
                        </div>
                    </div>

                    @if (Model.PrecioServicio.HasValue)
                    {
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <p>
                                    <strong><i class="bi bi-cash-coin"></i> Precio del Servicio:</strong><br />
                                    <span class="fs-4 text-success">@Model.PrecioServicio.Value.ToString("C")</span>
                                </p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Motivo))
                    {
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <p>
                                    <strong><i class="bi bi-file-text"></i> Motivo de la consulta:</strong><br />
                                    @Model.Motivo
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Historial Clínico (si existe) -->
            @if (ViewBag.TieneHistorial == true)
            {
                <div class="card shadow mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-file-medical"></i> Historial Clínico Generado
                        </h5>
                    </div>
                    <div class="card-body">
                        <p>Esta cita cuenta con un historial clínico registrado.</p>
                        <a asp-action="Details" asp-controller="HistorialesClinicos" asp-route-citaId="@Model.Id" class="btn btn-outline-success">
                            <i class="bi bi-eye"></i> Ver Historial Clínico
                        </a>
                    </div>
                </div>
            }

            <!-- Información de Pago (si existe) -->
            @if (ViewBag.EstadoPago != null)
            {
                var estadoPago = ViewBag.EstadoPago as string ?? "Pendiente";
                var montoTotal = ViewBag.MontoTotal ?? 0m;
                var montoPagado = ViewBag.MontoPagado ?? 0m;
                var tipoPago = ViewBag.TipoPago as string ?? "";
                var pagos = ViewBag.Pagos as List<Veterinaria.Domain.Entities.Pago>;

                <div class="card shadow mb-4 @(estadoPago == "Pagado" ? "border-success" : estadoPago == "Parcial" ? "border-warning" : "border-secondary")">
                    <div class="card-header @(estadoPago == "Pagado" ? "bg-success" : estadoPago == "Parcial" ? "bg-warning text-dark" : "bg-secondary") text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-credit-card"></i> Información de Pago
                            @if (estadoPago == "Pagado")
                            {
                                <span class="badge bg-light text-success float-end">Pagado Completamente</span>
                            }
                            else if (estadoPago == "Parcial")
                            {
                                <span class="badge bg-light text-warning float-end">Pago Parcial</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary float-end">Pendiente de Pago</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center border-end">
                                <small class="text-muted d-block">Total del Servicio</small>
                                <h4 class="text-primary">S/. @(((decimal)montoTotal).ToString("N2"))</h4>
                            </div>
                            <div class="col-md-4 text-center border-end">
                                <small class="text-muted d-block">Monto Pagado</small>
                                <h4 class="text-success">S/. @(((decimal)montoPagado).ToString("N2"))</h4>
                            </div>
                            <div class="col-md-4 text-center">
                                <small class="text-muted d-block">Saldo Pendiente</small>
                                <h4 class="@(((decimal)montoTotal - (decimal)montoPagado) > 0 ? "text-danger" : "text-success")">
                                    S/. @(((decimal)montoTotal - (decimal)montoPagado).ToString("N2"))
                                </h4>
                            </div>
                        </div>

                        @if (pagos != null && pagos.Any())
                        {
                            <hr />
                            <h6><i class="bi bi-receipt"></i> Pagos Realizados</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Referencia</th>
                                            <th>Fecha</th>
                                            <th>Método</th>
                                            <th>Tipo</th>
                                            <th class="text-end">Monto</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pago in pagos)
                                        {
                                            <tr>
                                                <td><code>@pago.Referencia</code></td>
                                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    @if (pago.MetodoPago == "Tarjeta")
                                                    {
                                                        <i class="bi bi-credit-card text-primary"></i>
                                                        <span>Tarjeta ****@pago.UltimosDigitosTarjeta</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-cash text-success"></i>
                                                        <span>Efectivo</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @(pago.TipoPago == "Completo" ? "bg-success" : pago.TipoPago == "Parcial" ? "bg-warning text-dark" : "bg-info")">
                                                        @pago.TipoPago
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold">S/. @pago.Monto.ToString("N2")</td>
                                                <td>
                                                    <a asp-controller="PagoCita" asp-action="DescargarComprobante" asp-route-pagoId="@pago.Id" 
                                                       class="btn btn-sm btn-outline-danger" title="Descargar Comprobante">
                                                        <i class="bi bi-file-pdf"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (estadoPago == "Pendiente")
                        {
                            <div class="alert alert-warning mt-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Pago pendiente.</strong> Debe realizar el pago para confirmar su cita.
                                <a asp-controller="PagoCita" asp-action="Pagar" asp-route-citaId="@Model.Id" class="btn btn-warning btn-sm ms-2">
                                    <i class="bi bi-credit-card"></i> Ir a Pagar
                                </a>
                            </div>
                        }
                        else if (estadoPago == "Parcial" && Model.Estado == "Completada")
                        {
                            @if (esPropietario)
                            {
                                <!-- Solo el propietario puede completar el pago -->
                                <div class="alert alert-info mt-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Tiene un saldo pendiente.</strong> Complete el pago restante.
                                    <a asp-controller="PagoCita" asp-action="CompletarPago" asp-route-citaId="@Model.Id" class="btn btn-info btn-sm ms-2">
                                        <i class="bi bi-cash"></i> Completar Pago
                                    </a>
                                </div>
                            }
                            else if (esAdmin)
                            {
                                <!-- El admin solo ve información, no puede pagar por el cliente -->
                                <div class="alert alert-warning mt-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    <strong>Saldo pendiente:</strong> S/. @((montoTotal - montoPagado).ToString("N2"))
                                    <br/>
                                    <small class="text-muted">El cliente debe completar el pago desde su cuenta.</small>
                                </div>
                            }
                        }

                        @if (estadoPago != "Pendiente")
                        {
                            <div class="d-flex gap-2 mt-3">
                                <a asp-controller="PagoCita" asp-action="DescargarFicha" asp-route-citaId="@Model.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-file-earmark-text"></i> Descargar Ficha de Cita
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            
            <!-- Acciones disponibles -->
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear"></i> Acciones
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        @if (esAdmin)
                        {
                            <!-- Acciones para Admin -->
                            @if (Model.Estado != "Completada" && Model.Estado != "Cancelada" && Model.Estado != "NoAsistio")
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                            }

                            @if (Model.Estado == "Completada" && ViewBag.TieneHistorial == false)
                            {
                                <a asp-action="Create" asp-controller="HistorialesClinicos" asp-route-citaId="@Model.Id" class="btn btn-success">
                                    <i class="bi bi-file-medical"></i> Crear Historial Clínico
                                </a>
                            }

                            <!-- Botones de cambio de estado rápido -->
                            @if (Model.Estado == "Pendiente")
                            {
                                <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="nuevoEstado" value="Confirmada" />
                                    <button type="submit" class="btn btn-primary" title="Confirmar cita y notificar al cliente">
                                        <i class="bi bi-check2-circle"></i> Confirmar Cita
                                    </button>
                                </form>
                            }

                            @if (Model.Estado == "Confirmada" || Model.Estado == "Pendiente")
                            {
                                <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="nuevoEstado" value="EnProceso" />
                                    <button type="submit" class="btn btn-info text-white" title="Iniciar atención - El cliente será notificado">
                                        <i class="bi bi-play-circle"></i> Iniciar Atención
                                    </button>
                                </form>
                            }

                            @if (Model.Estado == "EnProceso")
                            {
                                <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="nuevoEstado" value="Completada" />
                                    <button type="submit" class="btn btn-success" title="Completar cita - El cliente será notificado para recoger a su mascota">
                                        <i class="bi bi-check-circle-fill"></i> Completar y Notificar
                                    </button>
                                </form>
                            }

                            @if (Model.Estado != "Cancelada" && Model.Estado != "Completada" && Model.Estado != "NoAsistio")
                            {
                                <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" style="display: inline;" 
                                      onsubmit="return confirm('¿Está seguro de cancelar esta cita? El cliente será notificado.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="nuevoEstado" value="Cancelada" />
                                    <button type="submit" class="btn btn-outline-danger" title="Cancelar cita">
                                        <i class="bi bi-x-circle"></i> Cancelar
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <!-- Acciones para Usuario -->
                            @if (Model.Estado == "Pendiente" || Model.Estado == "Confirmada")
                            {
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelarModal">
                                    <i class="bi bi-x-circle"></i> Cancelar Cita
                                </button>
                            }
                            else if (Model.Estado == "Completada")
                            {
                                <div class="alert alert-success mb-0 w-100">
                                    <i class="bi bi-check-circle"></i>
                                    <strong>¡Cita completada!</strong> Gracias por confiar en nosotros.
                                </div>
                            }
                            else if (Model.Estado == "Cancelada")
                            {
                                <div class="alert alert-secondary mb-0 w-100">
                                    <i class="bi bi-info-circle"></i>
                                    Esta cita fue cancelada. Puede agendar una nueva cuando lo desee.
                                </div>
                            }
                            else if (Model.Estado == "NoAsistio")
                            {
                                <div class="alert alert-warning mb-0 w-100">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <strong>No asistió a esta cita.</strong> Por favor, intente llegar a tiempo a sus próximas citas.
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cancelación -->
<div class="modal fade" id="cancelarModal" tabindex="-1" aria-labelledby="cancelarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelarModalLabel">
                    <i class="bi bi-exclamation-triangle"></i> Confirmar Cancelación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de que desea cancelar esta cita?</p>
                <p class="text-muted">
                    <strong>Nota:</strong> Esta acción no se puede deshacer. La cita será marcada como cancelada y el espacio quedará disponible para otros clientes.
                </p>
                <div class="alert alert-info">
                    <strong>Cita:</strong> @Model.ServicioNombre<br />
                    <strong>Fecha:</strong> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")<br />
                    <strong>Veterinario:</strong> @Model.VeterinarioNombre
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> No, mantener la cita
                </button>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> Sí, cancelar cita
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .timeline-horizontal { display: flex; justify-content: space-between; align-items: center; position: relative; padding: 20px 0; }
        .timeline-horizontal::before { content: ''; position: absolute; top: 35px; left: 10%; right: 10%; height: 3px; background: #dee2e6; z-index: 0; }
        .timeline-item { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 1; }
        .timeline-icon { width: 50px; height: 50px; border-radius: 50%; background: #dee2e6; color: #6c757d; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 10px; transition: all 0.3s ease; border: 3px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .timeline-item.active .timeline-icon { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; transform: scale(1.1); }
        .timeline-content { font-size: 0.85rem; font-weight: 600; color: #6c757d; text-align: center; }
        .timeline-item.active .timeline-content { color: #667eea; }
    </style>

    <script>
        $(document).ready(function() {
            const esAdmin = @Json.Serialize(esAdmin);
            const citaId = @Model.Id;
            
            // Auto-dismiss alerts después de 5 segundos
            setTimeout(function() {
                $('.alert-dismissible').fadeOut('slow');
            }, 5000);

            // Actualización en tiempo real del estado (solo para usuarios)
            if (!esAdmin) {
                let intervalId = setInterval(function() {
                    actualizarEstado();
                }, 30000); // Cada 30 segundos

                function actualizarEstado() {
                    $.ajax({
                        url: '@Url.Action("GetEstado", "Citas")',
                        type: 'GET',
                        data: { id: citaId },
                        success: function(data) {
                            const estadoAnterior = $('#estadoBadge').text().trim();
                            const estadoNuevo = data.estado;
                            
                            if (estadoAnterior !== estadoNuevo) {
                                // Actualizar badge
                                actualizarBadgeEstado(estadoNuevo);
                                
                                // Actualizar timeline
                                actualizarTimeline(estadoNuevo);
                                
                                // Mostrar notificación
                                toastr.info('El estado de tu cita ha cambiado a: ' + estadoNuevo, 'Actualización');
                                
                                // Si cambia a Completada, NoAsistio o Cancelada, detener actualización
                                if (estadoNuevo === 'Completada' || estadoNuevo === 'NoAsistio' || estadoNuevo === 'Cancelada') {
                                    clearInterval(intervalId);
                                }
                            }
                            
                            $('#ultimaActualizacion').text('Actualizado: ' + data.fechaActualizacion);
                        },
                        error: function() {
                            console.log('Error al actualizar estado');
                        }
                    });
                }

                function actualizarBadgeEstado(estado) {
                    const badge = $('#estadoBadge');
                    badge.removeClass();
                    
                    switch(estado) {
                        case 'Pendiente':
                            badge.addClass('badge bg-secondary fs-4');
                            break;
                        case 'Confirmada':
                            badge.addClass('badge bg-primary fs-4');
                            break;
                        case 'EnProceso':
                            badge.addClass('badge bg-warning text-dark fs-4');
                            break;
                        case 'Completada':
                            badge.addClass('badge bg-success fs-4');
                            break;
                        case 'Cancelada':
                        case 'NoAsistio':
                            badge.addClass('badge bg-danger fs-4');
                            break;
                    }
                    
                    badge.text(estado);
                }

                function actualizarTimeline(estado) {
                    $('.timeline-item').removeClass('active');
                    
                    if (estado !== 'Cancelada' && estado !== 'NoAsistio') {
                        $('.timeline-item').eq(0).addClass('active'); // Agendada
                        
                        if (estado === 'Confirmada' || estado === 'EnProceso' || estado === 'Completada') {
                            $('.timeline-item').eq(1).addClass('active'); // Confirmada
                        }
                        
                        if (estado === 'EnProceso' || estado === 'Completada') {
                            $('.timeline-item').eq(2).addClass('active'); // En Proceso
                        }
                        
                        if (estado === 'Completada') {
                            $('.timeline-item').eq(3).addClass('active'); // Completada
                        }
                    }
                }

                // Actualizar inmediatamente al cargar
                actualizarEstado();
            }
        });
    </script>
}
