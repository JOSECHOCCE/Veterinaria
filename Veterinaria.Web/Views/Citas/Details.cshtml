@model Veterinaria.Web.Models.Dto.CitaDto
@{
    ViewData["Title"] = "Detalle de Cita";
    var esAdmin = ViewBag.EsAdmin ?? false;
    var esPropietario = ViewBag.EsPropietario ?? false;
    var propietarioNombre = ViewBag.PropietarioNombre ?? "";
}

<div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">
            @(esAdmin ? "Detalle administrativo de la cita" : "Información de tu cita agendada")
        </p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <!-- Mensajes de TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-secondary-container text-on-secondary-container p-4 rounded-xl mb-lg border border-secondary flex justify-between items-center">
            <span class="flex items-center gap-2"><span class="material-symbols-outlined">check_circle</span> @TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-lg border border-error flex justify-between items-center">
            <span class="flex items-center gap-2"><span class="material-symbols-outlined">error</span> @TempData["Error"]</span>
        </div>
    }

    <!-- Panel de Cliente (Tiempo Real) -->
    @if (!esAdmin)
    {
        <div class="bg-primary text-on-primary rounded-xl shadow-sm mb-lg p-lg border border-outline-variant relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-20">
                <span class="material-symbols-outlined text-8xl">clinical_notes</span>
            </div>
            <div class="relative z-10">
                <div class="flex justify-between items-center mb-4">
                    <h4 class="font-headline-sm text-headline-sm flex items-center gap-2">
                        <span class="material-symbols-outlined">activity_zone</span> Estado de tu Cita
                    </h4>
                    <span id="ultimaActualizacion" class="text-xs opacity-80"></span>
                </div>
                
                <div class="text-center py-6">
                    <span id="estadoBadge" class="inline-block bg-surface text-on-surface px-8 py-3 rounded-full font-headline-md text-headline-md shadow-md mb-8">
                        @Model.Estado
                    </span>

                    <!-- Timeline -->
                    <div class="flex justify-between items-center relative max-w-2xl mx-auto px-4">
                        <div class="absolute top-1/2 left-[10%] right-[10%] h-1 bg-primary-container -z-10 -translate-y-1/2 rounded-full"></div>
                        
                        <div class="flex flex-col items-center gap-2 timeline-item @(Model.Estado != "Cancelada" ? "active" : "")">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center transition-all bg-primary-container text-primary border-4 border-primary">
                                <span class="material-symbols-outlined">edit_calendar</span>
                            </div>
                            <span class="text-xs font-semibold">Agendada</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 timeline-item @(Model.Estado == "Confirmada" || Model.Estado == "EnProceso" || Model.Estado == "Completada" ? "active" : "opacity-50 grayscale")">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center transition-all bg-primary-container text-primary border-4 border-primary">
                                <span class="material-symbols-outlined">thumb_up</span>
                            </div>
                            <span class="text-xs font-semibold">Confirmada</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 timeline-item @(Model.Estado == "EnProceso" || Model.Estado == "Completada" ? "active" : "opacity-50 grayscale")">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center transition-all bg-primary-container text-primary border-4 border-primary">
                                <span class="material-symbols-outlined">stethoscope</span>
                            </div>
                            <span class="text-xs font-semibold">En Proceso</span>
                        </div>
                        <div class="flex flex-col items-center gap-2 timeline-item @(Model.Estado == "Completada" ? "active" : "opacity-50 grayscale")">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center transition-all bg-primary-container text-primary border-4 border-primary">
                                <span class="material-symbols-outlined">done_all</span>
                            </div>
                            <span class="text-xs font-semibold">Completada</span>
                        </div>
                    </div>

                    @if (Model.Estado == "Cancelada" || Model.Estado == "NoAsistio")
                    {
                        <div class="mt-6 bg-error-container text-on-error-container p-3 rounded-lg flex justify-center items-center gap-2 border border-error max-w-md mx-auto">
                            <span class="material-symbols-outlined">cancel</span>
                            <strong>Esta cita fue @(Model.Estado == "Cancelada" ? "cancelada" : "marcada como no asistida").</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-md">
        <div class="lg:col-span-2 space-y-md">
            <!-- Info Cita -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="p-md bg-surface-container-low border-b border-outline-variant">
                    <h4 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">info</span> Información de la Cita
                    </h4>
                </div>
                <div class="p-lg grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
                    <div>
                        <span class="text-on-surface-variant font-label-md text-label-md uppercase tracking-wider block mb-1">Mascota</span>
                        <p class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">pets</span> @Model.MascotaNombre
                        </p>
                        @if (esAdmin)
                        {
                            <p class="text-sm text-on-surface-variant mt-1">Propietario: @propietarioNombre</p>
                        }
                    </div>
                    <div>
                        <span class="text-on-surface-variant font-label-md text-label-md uppercase tracking-wider block mb-1">Veterinario</span>
                        <p class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">medical_information</span> @Model.VeterinarioNombre
                        </p>
                        <p class="text-sm text-on-surface-variant mt-1">Servicio: <span class="bg-surface-variant px-2 py-0.5 rounded text-xs font-semibold">@Model.ServicioNombre</span></p>
                    </div>

                    <div class="sm:col-span-2 border-t border-outline-variant pt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <span class="text-on-surface-variant text-sm block mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-sm">calendar_month</span> Fecha</span>
                            <p class="font-semibold">@Model.FechaHora.ToString("dddd, dd 'de' MMMM yyyy")</p>
                        </div>
                        <div>
                            <span class="text-on-surface-variant text-sm block mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-sm">schedule</span> Hora</span>
                            <p class="font-semibold">@Model.FechaHora.ToString("HH:mm")</p>
                        </div>
                        <div>
                            <span class="text-on-surface-variant text-sm block mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-sm">flag</span> Estado</span>
                            @{
                                var badgeC = Model.Estado switch {
                                    "Completada" => "bg-secondary-container text-on-secondary-container",
                                    "Confirmada" => "bg-primary-container text-on-primary-container",
                                    "EnProceso" => "bg-tertiary-container text-on-tertiary-container",
                                    "Cancelada" => "bg-error-container text-on-error-container",
                                    "NoAsistio" => "bg-error text-on-error",
                                    _ => "bg-surface-variant text-on-surface"
                                };
                            }
                            <span class="inline-block px-3 py-1 rounded-full font-label-sm text-label-sm @badgeC" id="estadoActual">@Model.Estado</span>
                        </div>
                    </div>

                    @if (Model.PrecioServicio.HasValue)
                    {
                        <div class="sm:col-span-2 border-t border-outline-variant pt-6">
                            <span class="text-on-surface-variant text-sm block mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-sm">payments</span> Precio del Servicio</span>
                            <p class="font-headline-sm text-headline-sm text-secondary">@Model.PrecioServicio.Value.ToString("C")</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Motivo))
                    {
                        <div class="sm:col-span-2 border-t border-outline-variant pt-6">
                            <span class="text-on-surface-variant text-sm block mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-sm">description</span> Motivo</span>
                            <p class="text-on-surface bg-surface-container p-3 rounded-md">@Model.Motivo</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Historial -->
            @if (ViewBag.TieneHistorial == true)
            {
                <div class="bg-secondary-container/20 border border-secondary rounded-xl p-md flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary text-3xl">clinical_notes</span>
                        <div>
                            <h5 class="font-headline-sm text-headline-sm text-on-surface">Historial Clínico Generado</h5>
                            <p class="text-sm text-on-surface-variant">Esta cita cuenta con un historial clínico registrado.</p>
                        </div>
                    </div>
                    <a asp-action="Details" asp-controller="HistorialesClinicos" asp-route-citaId="@Model.Id" class="bg-secondary text-on-secondary px-4 py-2 rounded-full text-sm font-semibold hover:bg-secondary/90 transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">visibility</span> Ver
                    </a>
                </div>
            }
        </div>

        <div class="space-y-md">
            <!-- Pagos -->
            @if (ViewBag.EstadoPago != null)
            {
                var estadoPago = ViewBag.EstadoPago as string ?? "Pendiente";
                var montoTotal = ViewBag.MontoTotal ?? 0m;
                var montoPagado = ViewBag.MontoPagado ?? 0m;
                var pagos = ViewBag.Pagos as List<Veterinaria.Domain.Entities.Pago>;
                
                var borderClass = estadoPago == "Pagado" ? "border-secondary" : estadoPago == "Parcial" ? "border-tertiary" : "border-outline-variant";
                var headerClass = estadoPago == "Pagado" ? "bg-secondary text-on-secondary" : estadoPago == "Parcial" ? "bg-tertiary-container text-on-tertiary-container" : "bg-surface-container-highest text-on-surface";

                <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border @borderClass">
                    <div class="p-md flex justify-between items-center @headerClass">
                        <h5 class="font-headline-sm text-headline-sm flex items-center gap-2">
                            <span class="material-symbols-outlined">point_of_sale</span> Pagos
                        </h5>
                        <span class="px-2 py-0.5 rounded text-xs font-semibold bg-surface/50">
                            @(estadoPago == "Pagado" ? "Completado" : estadoPago == "Parcial" ? "Parcial" : "Pendiente")
                        </span>
                    </div>
                    <div class="p-md">
                        <div class="grid grid-cols-2 gap-4 mb-4 text-center">
                            <div class="bg-surface-container p-2 rounded">
                                <span class="text-xs text-on-surface-variant block">Total</span>
                                <span class="font-semibold text-primary">S/. @(((decimal)montoTotal).ToString("N2"))</span>
                            </div>
                            <div class="bg-surface-container p-2 rounded">
                                <span class="text-xs text-on-surface-variant block">Saldo</span>
                                <span class="font-semibold @(((decimal)montoTotal - (decimal)montoPagado) > 0 ? "text-error" : "text-secondary")">S/. @(((decimal)montoTotal - (decimal)montoPagado).ToString("N2"))</span>
                            </div>
                        </div>

                        @if (pagos != null && pagos.Any())
                        {
                            <div class="text-sm space-y-2 mb-4">
                                @foreach (var pago in pagos)
                                {
                                    <div class="flex justify-between items-center p-2 bg-surface-container-low rounded border border-outline-variant">
                                        <div>
                                            <p class="font-semibold">S/. @pago.Monto.ToString("N2")</p>
                                            <p class="text-xs text-on-surface-variant">@pago.FechaPago.ToString("dd/MM") • @(pago.MetodoPago == "Tarjeta" ? "Tarj" : "Efec")</p>
                                        </div>
                                        <a asp-controller="PagoCita" asp-action="DescargarComprobante" asp-route-pagoId="@pago.Id" class="text-error hover:bg-error-container p-1 rounded-full transition-colors" title="PDF">
                                            <span class="material-symbols-outlined text-lg">picture_as_pdf</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        @if (estadoPago == "Pendiente")
                        {
                            <a asp-controller="PagoCita" asp-action="Pagar" asp-route-citaId="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-tertiary text-on-tertiary px-4 py-2 rounded-md font-semibold text-sm hover:opacity-90 transition-colors">
                                <span class="material-symbols-outlined text-sm">payment</span> Ir a Pagar
                            </a>
                        }
                        else if (estadoPago == "Parcial" && esPropietario)
                        {
                            <a asp-controller="PagoCita" asp-action="CompletarPago" asp-route-citaId="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-tertiary text-on-tertiary px-4 py-2 rounded-md font-semibold text-sm hover:opacity-90 transition-colors">
                                <span class="material-symbols-outlined text-sm">payments</span> Completar Pago
                            </a>
                        }
                        
                        @if (estadoPago != "Pendiente")
                        {
                            <a asp-controller="PagoCita" asp-action="DescargarFicha" asp-route-citaId="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-surface border border-outline-variant text-primary mt-2 px-4 py-2 rounded-md font-semibold text-sm hover:bg-surface-container-low transition-colors">
                                <span class="material-symbols-outlined text-sm">receipt_long</span> Ficha
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Acciones -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-surface-container-high p-md border-b border-outline-variant">
                    <h5 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined">touch_app</span> Acciones
                    </h5>
                </div>
                <div class="p-md space-y-2">
                    @if (esAdmin)
                    {
                        @if (Model.Estado != "Completada" && Model.Estado != "Cancelada" && Model.Estado != "NoAsistio")
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-surface text-on-surface border border-outline-variant px-4 py-2 rounded-md hover:bg-surface-container-low transition-colors text-sm font-semibold">
                                <span class="material-symbols-outlined text-sm">edit</span> Editar Cita
                            </a>
                        }

                        @if (Model.Estado == "Completada" && ViewBag.TieneHistorial == false)
                        {
                            <a asp-action="Create" asp-controller="HistorialesClinicos" asp-route-citaId="@Model.Id" class="w-full flex items-center justify-center gap-2 bg-secondary text-on-secondary px-4 py-2 rounded-md hover:bg-secondary/90 transition-colors text-sm font-semibold">
                                <span class="material-symbols-outlined text-sm">note_add</span> Crear Historial
                            </a>
                        }

                        @if (Model.Estado == "Pendiente")
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post">
                                <input type="hidden" name="nuevoEstado" value="Confirmada" />
                                <button type="submit" class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-md hover:bg-primary/90 transition-colors text-sm font-semibold">
                                    <span class="material-symbols-outlined text-sm">check</span> Confirmar Cita
                                </button>
                            </form>
                        }

                        @if (Model.Estado == "Confirmada" || Model.Estado == "Pendiente")
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post">
                                <input type="hidden" name="nuevoEstado" value="EnProceso" />
                                <button type="submit" class="w-full flex items-center justify-center gap-2 bg-tertiary text-on-tertiary px-4 py-2 rounded-md hover:opacity-90 transition-colors text-sm font-semibold">
                                    <span class="material-symbols-outlined text-sm">play_arrow</span> Iniciar Atención
                                </button>
                            </form>
                        }

                        @if (Model.Estado == "EnProceso")
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post">
                                <input type="hidden" name="nuevoEstado" value="Completada" />
                                <button type="submit" class="w-full flex items-center justify-center gap-2 bg-secondary text-on-secondary px-4 py-2 rounded-md hover:bg-secondary/90 transition-colors text-sm font-semibold">
                                    <span class="material-symbols-outlined text-sm">done_all</span> Completar
                                </button>
                            </form>
                        }

                        @if (Model.Estado != "Cancelada" && Model.Estado != "Completada" && Model.Estado != "NoAsistio")
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Cancelar cita?');">
                                <input type="hidden" name="nuevoEstado" value="Cancelada" />
                                <button type="submit" class="w-full flex items-center justify-center gap-2 bg-surface text-error border border-error px-4 py-2 rounded-md hover:bg-error-container transition-colors text-sm font-semibold mt-4">
                                    <span class="material-symbols-outlined text-sm">cancel</span> Cancelar
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        @if (Model.Estado == "Pendiente" || Model.Estado == "Confirmada")
                        {
                            <button onclick="document.getElementById('modalCancelar').classList.remove('hidden')" class="w-full flex items-center justify-center gap-2 bg-surface text-error border border-error px-4 py-2 rounded-md hover:bg-error-container transition-colors text-sm font-semibold">
                                <span class="material-symbols-outlined text-sm">cancel</span> Cancelar Cita
                            </button>
                        }
                        else
                        {
                            <p class="text-center text-sm text-on-surface-variant py-2">No hay acciones disponibles</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cliente -->
@if (!esAdmin && (Model.Estado == "Pendiente" || Model.Estado == "Confirmada"))
{
    <div id="modalCancelar" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/50 backdrop-blur-sm">
        <div class="bg-surface rounded-xl shadow-lg max-w-sm w-full overflow-hidden text-left border border-outline-variant">
            <div class="bg-error p-4 text-on-error flex justify-between items-center">
                <h5 class="font-headline-sm text-headline-sm flex items-center gap-2"><span class="material-symbols-outlined">warning</span> Cancelar Cita</h5>
                <button onclick="document.getElementById('modalCancelar').classList.add('hidden')" class="hover:bg-error-container/20 p-1 rounded-full"><span class="material-symbols-outlined">close</span></button>
            </div>
            <div class="p-lg">
                <p class="text-sm mb-4">¿Desea cancelar esta cita? Esta acción no se puede deshacer.</p>
                <div class="flex justify-end gap-3">
                    <button onclick="document.getElementById('modalCancelar').classList.add('hidden')" class="px-4 py-2 rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">Volver</button>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="m-0">
                        <button type="submit" class="bg-error text-on-error px-4 py-2 rounded-full font-label-md text-label-md hover:bg-error/90 transition-colors shadow-sm">Sí, cancelar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (!esAdmin)
    {
        <script>
            $(document).ready(function() {
                const citaId = @Model.Id;
                let intervalId = setInterval(actualizarEstado, 30000);

                function actualizarEstado() {
                    $.get('@Url.Action("GetEstado", "Citas")', { id: citaId }, function(data) {
                        const actual = $('#estadoBadge').text().trim();
                        if (actual !== data.estado) {
                            location.reload(); // Recarga simple para mantener UI de Tailwind
                        }
                        $('#ultimaActualizacion').text('Act: ' + data.fechaActualizacion);
                    });
                }
                actualizarEstado();
            });
        </script>
    }
}
