@model Veterinaria.Web.Models.Dto.CitaDto
@{
    ViewData["Title"] = "Nueva Cita";
    var tieneMascotas = ViewBag.TieneMascotas ?? false;
    var esAdmin = ViewBag.EsAdmin ?? false;
}

<div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Complete los datos para programar una nueva cita.</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="bg-primary/5 border-b border-outline-variant p-md">
            <h3 class="font-headline-sm text-headline-sm text-primary flex items-center gap-2">
                <span class="material-symbols-outlined">calendar_add_on</span>
                Agendar Nueva Cita
            </h3>
        </div>
        <div class="p-lg">
            <form asp-action="Create" method="post" id="citaForm">
                <div asp-validation-summary="ModelOnly" class="text-error mb-4 bg-error-container p-3 rounded-md border border-error"></div>

                @if (!esAdmin)
                {
                    <!-- Opción para cliente -->
                    <div class="mb-md">
                        <label class="block font-label-md text-label-md text-on-surface mb-xs">¿Qué mascota desea agendar? *</label>
                        <div class="flex flex-wrap gap-2">
                            @if (tieneMascotas)
                            {
                                <label class="flex-1 flex items-center justify-center p-3 border border-primary bg-primary-container/10 rounded-md cursor-pointer hover:bg-primary-container/20 transition-colors">
                                    <input type="radio" name="opcionMascota" id="opcionExistente" value="existente" checked class="mr-2 text-primary focus:ring-primary" />
                                    <span class="font-label-md text-label-md">Seleccionar mi mascota</span>
                                </label>
                            }
                            <label class="flex-1 flex items-center justify-center p-3 border border-secondary bg-secondary-container/10 rounded-md cursor-pointer hover:bg-secondary-container/20 transition-colors">
                                <input type="radio" name="opcionMascota" id="opcionNueva" value="nueva" @(!tieneMascotas ? "checked" : "") class="mr-2 text-secondary focus:ring-secondary" />
                                <span class="font-label-md text-label-md">Registrar nueva mascota</span>
                            </label>
                        </div>
                    </div>

                    @if (tieneMascotas)
                    {
                        <div id="panelMascotaExistente" class="mb-md">
                            <label asp-for="MascotaId" class="block font-label-md text-label-md text-on-surface mb-xs">Seleccione su mascota *</label>
                            <select asp-for="MascotaId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Mascotas">
                                <option value="">-- Seleccione una mascota --</option>
                            </select>
                            <span asp-validation-for="MascotaId" class="text-error text-xs"></span>
                        </div>
                    }

                    <!-- Panel nueva mascota -->
                    <div id="panelMascotaNueva" class="@(tieneMascotas ? "hidden" : "") mb-md">
                        <div class="bg-secondary-container/10 rounded-lg border border-secondary p-md space-y-3">
                            <h5 class="font-label-md text-label-md text-secondary font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">add_circle</span> Datos de la Nueva Mascota
                            </h5>
                            <div>
                                <label for="mascotaNombre" class="block font-label-md text-label-md text-on-surface mb-xs">Nombre *</label>
                                <input type="text" id="mascotaNombre" name="mascotaNombre" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Ej: Max" required />
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label for="mascotaEspecie" class="block font-label-md text-label-md text-on-surface mb-xs">Especie *</label>
                                    <select id="mascotaEspecie" name="mascotaEspecie" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" required>
                                        <option value="">-- Seleccione --</option>
                                        <option value="Perro">Perro</option>
                                        <option value="Gato">Gato</option>
                                        <option value="Ave">Ave</option>
                                        <option value="Conejo">Conejo</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="mascotaRaza" class="block font-label-md text-label-md text-on-surface mb-xs">Raza</label>
                                    <input type="text" id="mascotaRaza" name="mascotaRaza" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Ej: Golden Retriever" />
                                </div>
                            </div>
                            <div>
                                <label for="mascotaPeso" class="block font-label-md text-label-md text-on-surface mb-xs">Peso (kg)</label>
                                <input type="number" step="0.1" id="mascotaPeso" name="mascotaPeso" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Ej: 15.5" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-md">
                        <label asp-for="MascotaId" class="block font-label-md text-label-md text-on-surface mb-xs">Mascota *</label>
                        <select asp-for="MascotaId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Mascotas">
                            <option value="">-- Seleccione una mascota --</option>
                        </select>
                        <span asp-validation-for="MascotaId" class="text-error text-xs"></span>
                        <div id="mascotaInfo" class="text-xs text-on-surface-variant mt-1"></div>
                    </div>
                }

                <div class="mb-md">
                    <label asp-for="VeterinarioId" class="block font-label-md text-label-md text-on-surface mb-xs">Veterinario *</label>
                    <select asp-for="VeterinarioId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Veterinarios" id="veterinarioSelect">
                        <option value="">-- Seleccione un veterinario --</option>
                    </select>
                    <span asp-validation-for="VeterinarioId" class="text-error text-xs"></span>
                    <div id="veterinarioHorario" class="text-xs text-on-surface-variant mt-1"></div>
                </div>

                <div class="mb-md">
                    <label asp-for="ServicioId" class="block font-label-md text-label-md text-on-surface mb-xs">Servicio *</label>
                    <select asp-for="ServicioId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Servicios" id="servicioSelect">
                        <option value="">-- Seleccione un servicio --</option>
                    </select>
                    <span asp-validation-for="ServicioId" class="text-error text-xs"></span>
                    <div id="servicioInfo" class="text-xs text-on-surface-variant mt-1"></div>
                </div>

                <div class="mb-md">
                    <label asp-for="FechaHora" class="block font-label-md text-label-md text-on-surface mb-xs">Fecha y Hora *</label>
                    <input asp-for="FechaHora" type="datetime-local" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" id="fechaHoraInput" />
                    <span asp-validation-for="FechaHora" class="text-error text-xs"></span>
                    <div id="fechaHoraInfo" class="text-xs text-on-surface-variant mt-1">Debe seleccionar una fecha y hora futura</div>
                </div>

                <div class="mb-md">
                    <label asp-for="Motivo" class="block font-label-md text-label-md text-on-surface mb-xs">Motivo de la consulta *</label>
                    <textarea asp-for="Motivo" rows="3" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Describa el motivo de la cita..."></textarea>
                    <span asp-validation-for="Motivo" class="text-error text-xs"></span>
                </div>

                <div id="resumenCita" class="hidden bg-primary-container/10 border border-primary rounded-lg p-md mb-md">
                    <h5 class="font-label-md text-label-md text-primary font-semibold mb-2 flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">info</span> Resumen de la Cita
                    </h5>
                    <div id="resumenContent" class="text-sm text-on-surface space-y-1"></div>
                </div>

                <div class="flex justify-end gap-3 pt-md border-t border-outline-variant">
                    <a asp-action="Index" class="px-md py-sm rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">Cancelar</a>
                    <button type="submit" class="bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm flex items-center gap-2" id="btnAgendar">
                        <span class="material-symbols-outlined text-sm">check_circle</span>
                        Agendar Cita
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            let servicioData = null;
            let veterinarioData = null;
            const esAdmin = @Json.Serialize(esAdmin);
            const tieneMascotas = @Json.Serialize(tieneMascotas);

            if (!esAdmin) {
                $('input[name="opcionMascota"]').on('change', function() {
                    if ($(this).val() === 'existente') {
                        $('#panelMascotaExistente').removeClass('hidden');
                        $('#panelMascotaNueva').addClass('hidden');
                        $('#MascotaId').prop('required', true);
                        $('#mascotaNombre, #mascotaEspecie').prop('required', false);
                    } else {
                        $('#panelMascotaExistente').addClass('hidden');
                        $('#panelMascotaNueva').removeClass('hidden');
                        $('#MascotaId').prop('required', false);
                        $('#mascotaNombre, #mascotaEspecie').prop('required', true);
                    }
                });

                $('#citaForm').on('submit', function(e) {
                    const opcion = $('input[name="opcionMascota"]:checked').val();
                    if (opcion === 'nueva') {
                        if (!$('#mascotaNombre').val().trim() || !$('#mascotaEspecie').val()) {
                            e.preventDefault();
                            alert('Complete los datos obligatorios de la mascota (Nombre y Especie)');
                            return false;
                        }
                        $(this).attr('action', '@Url.Action("CrearMascotaYCita", "Citas")');
                    } else {
                        if (!$('#MascotaId').val()) { e.preventDefault(); alert('Seleccione una mascota'); return false; }
                        $(this).attr('action', '@Url.Action("Create", "Citas")');
                    }
                    const fechaHora = new Date($('#fechaHoraInput').val());
                    if (fechaHora <= new Date()) { e.preventDefault(); alert('La fecha y hora debe ser futura'); return false; }
                });
            }

            $('#servicioSelect').on('change', function() {
                const servicioId = $(this).val();
                if (servicioId) {
                    $.get('@Url.Action("GetServicioInfo", "Citas")', { servicioId }, function(data) {
                        servicioData = data;
                        $('#servicioInfo').html('<span class="text-secondary font-semibold">' + data.nombre + '</span> — ' + data.duracionMinutos + ' min — ' + formatCurrency(data.precio));
                        actualizarResumen();
                    });
                } else { $('#servicioInfo').html(''); servicioData = null; actualizarResumen(); }
            });

            $('#veterinarioSelect').on('change', function() {
                const veterinarioId = $(this).val();
                if (veterinarioId) {
                    $.get('@Url.Action("GetVeterinarioHorarios", "Citas")', { veterinarioId }, function(data) {
                        veterinarioData = data;
                        $('#veterinarioHorario').html('Horario: <strong>' + data.horarioInicio + ' - ' + data.horarioFin + '</strong>');
                        validarHorario(); actualizarResumen();
                    });
                } else { $('#veterinarioHorario').html(''); veterinarioData = null; actualizarResumen(); }
            });

            $('#fechaHoraInput').on('change', function() {
                const f = new Date($(this).val());
                if (f <= new Date()) { $('#fechaHoraInfo').html('<span class="text-error">La fecha debe ser futura</span>'); }
                else { $('#fechaHoraInfo').html('<span class="text-secondary">Fecha válida</span>'); validarHorario(); }
                actualizarResumen();
            });

            function validarHorario() {
                if (!veterinarioData || !$('#fechaHoraInput').val()) return;
                const f = new Date($('#fechaHoraInput').val());
                const hm = f.getHours() * 60 + f.getMinutes();
                const [ih, im] = veterinarioData.horarioInicio.split(':').map(Number);
                const [fh, fm] = veterinarioData.horarioFin.split(':').map(Number);
                if (hm < ih * 60 + im || hm > fh * 60 + fm) {
                    $('#fechaHoraInfo').html('<span class="text-error">Fuera del horario (' + veterinarioData.horarioInicio + ' - ' + veterinarioData.horarioFin + ')</span>');
                } else {
                    $('#fechaHoraInfo').html('<span class="text-secondary">Dentro del horario de atención</span>');
                }
            }

            function actualizarResumen() {
                if (!$('#fechaHoraInput').val() || !servicioData || !veterinarioData) { $('#resumenCita').addClass('hidden'); return; }
                const f = new Date($('#fechaHoraInput').val());
                $('#resumenContent').html(
                    '<p><strong>Veterinario:</strong> ' + $('#veterinarioSelect option:selected').text() + '</p>' +
                    '<p><strong>Servicio:</strong> ' + servicioData.nombre + ' (' + servicioData.duracionMinutos + ' min)</p>' +
                    '<p><strong>Fecha:</strong> ' + f.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + '</p>' +
                    '<p><strong>Hora:</strong> ' + f.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) + '</p>' +
                    '<p><strong>Precio:</strong> ' + formatCurrency(servicioData.precio) + '</p>'
                );
                $('#resumenCita').removeClass('hidden');
            }

            function formatCurrency(v) { return new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(v); }

            $('#citaForm').on('submit', function(e) {
                const f = new Date($('#fechaHoraInput').val());
                if (f <= new Date()) { e.preventDefault(); alert('La fecha y hora debe ser futura'); return false; }
            });
        });
    </script>
}
