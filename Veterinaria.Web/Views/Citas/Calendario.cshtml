@{
    ViewData["Title"] = "Calendario de Citas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar3 me-2"></i>@ViewData["Title"]</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i>Ver Lista
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Nueva Cita
        </a>
    </div>
</div>

<!-- Leyenda de colores -->
<div class="card mb-4">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <span class="fw-bold me-2">Estado:</span>
            <span class="badge" style="background-color: #ffc107; color: #000;">
                <i class="bi bi-clock me-1"></i>Pendiente
            </span>
            <span class="badge" style="background-color: #0d6efd;">
                <i class="bi bi-check-circle me-1"></i>Confirmada
            </span>
            <span class="badge" style="background-color: #17a2b8;">
                <i class="bi bi-play-circle me-1"></i>En Proceso
            </span>
            <span class="badge" style="background-color: #198754;">
                <i class="bi bi-check2-all me-1"></i>Completada
            </span>
            <span class="badge" style="background-color: #dc3545;">
                <i class="bi bi-x-circle me-1"></i>Cancelada
            </span>
        </div>
    </div>
</div>

<!-- Calendario -->
<div class="card shadow">
    <div class="card-body">
        <div id="calendario"></div>
    </div>
</div>

<!-- Modal de Detalles de Cita -->
<div class="modal fade" id="citaModal" tabindex="-1" aria-labelledby="citaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="citaModalLabel">
                    <i class="bi bi-calendar-check me-2"></i>Detalles de la Cita
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-heart-pulse me-1"></i>Mascota
                            </label>
                            <p class="form-control-plaintext fs-5" id="modal-mascota"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-person me-1"></i>Propietario
                            </label>
                            <p class="form-control-plaintext" id="modal-propietario"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-clipboard-pulse me-1"></i>Servicio
                            </label>
                            <p class="form-control-plaintext" id="modal-servicio"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-person-badge me-1"></i>Veterinario
                            </label>
                            <p class="form-control-plaintext" id="modal-veterinario"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-calendar me-1"></i>Fecha y Hora
                            </label>
                            <p class="form-control-plaintext fs-5" id="modal-fecha"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-hourglass-split me-1"></i>Duración
                            </label>
                            <p class="form-control-plaintext" id="modal-duracion"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-currency-dollar me-1"></i>Precio
                            </label>
                            <p class="form-control-plaintext" id="modal-precio"></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">
                                <i class="bi bi-flag me-1"></i>Estado
                            </label>
                            <p class="form-control-plaintext" id="modal-estado"></p>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted">
                        <i class="bi bi-chat-text me-1"></i>Motivo de la Consulta
                    </label>
                    <p class="form-control-plaintext border rounded p-2 bg-light" id="modal-motivo"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cerrar
                </button>
                <a href="#" id="modal-btn-ver" class="btn btn-primary">
                    <i class="bi bi-eye me-1"></i>Ver Detalles Completos
                </a>
                <a href="#" id="modal-btn-editar" class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendario');
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                // Configuración básica
                initialView: 'timeGridWeek',
                locale: 'es',
                timeZone: 'local',
                
                // Horarios
                slotMinTime: '08:00:00',
                slotMaxTime: '20:00:00',
                slotDuration: '00:30:00',
                slotLabelInterval: '01:00:00',
                
                // Configuración de días
                weekends: true,
                firstDay: 1, // Lunes
                
                // Altura
                height: 'auto',
                contentHeight: 600,
                
                // Header con navegación
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                
                // Botones personalizados
                buttonText: {
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    day: 'Día',
                    list: 'Lista'
                },
                
                // Eventos
                events: {
                    url: '@Url.Action("CalendarioData", "Citas")',
                    method: 'GET',
                    failure: function() {
                        alert('Error al cargar las citas');
                    }
                },
                
                // Click en evento - Abrir modal
                eventClick: function(info) {
                    info.jsEvent.preventDefault();
                    
                    var event = info.event;
                    var props = event.extendedProps;
                    
                    // Llenar el modal
                    document.getElementById('modal-mascota').textContent = props.mascota || 'N/A';
                    document.getElementById('modal-propietario').textContent = props.propietario || 'N/A';
                    document.getElementById('modal-servicio').textContent = props.servicio || 'N/A';
                    document.getElementById('modal-veterinario').textContent = props.veterinario || 'N/A';
                    
                    // Formatear fecha
                    var fecha = new Date(event.start);
                    var opciones = { 
                        weekday: 'long', 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    };
                    document.getElementById('modal-fecha').textContent = fecha.toLocaleDateString('es-ES', opciones);
                    
                    document.getElementById('modal-duracion').textContent = props.duracion + ' minutos';
                    document.getElementById('modal-precio').textContent = 'S/. ' + props.precio.toFixed(2);
                    document.getElementById('modal-motivo').textContent = props.motivo || 'No especificado';
                    
                    // Estado con badge
                    var estadoBadge = getEstadoBadge(props.estado);
                    document.getElementById('modal-estado').innerHTML = estadoBadge;
                    
                    // URLs de botones
                    document.getElementById('modal-btn-ver').href = event.url;
                    document.getElementById('modal-btn-editar').href = '@Url.Action("Edit", "Citas")/' + event.id;
                    
                    // Mostrar modal
                    var modal = new bootstrap.Modal(document.getElementById('citaModal'));
                    modal.show();
                },
                
                // Hover en evento
                eventDidMount: function(info) {
                    var props = info.event.extendedProps;
                    info.el.setAttribute('title', 
                        props.mascota + ' - ' + props.servicio + '\n' +
                        'Veterinario: ' + props.veterinario + '\n' +
                        'Estado: ' + props.estado
                    );
                },
                
                // Click en fecha vacía - Crear nueva cita
                dateClick: function(info) {
                    if (info.date > new Date()) {
                        var fechaFormato = info.date.toISOString().slice(0, 16);
                        window.location.href = '@Url.Action("Create", "Citas")?fechaHora=' + fechaFormato;
                    }
                },
                
                // Día actual resaltado
                nowIndicator: true,
                
                // Vista responsiva
                views: {
                    timeGridWeek: {
                        titleFormat: { year: 'numeric', month: 'long', day: 'numeric' }
                    },
                    dayGridMonth: {
                        titleFormat: { year: 'numeric', month: 'long' }
                    }
                },
                
                // No mostrar horarios all-day
                allDaySlot: false
            });
            
            calendar.render();
        });
        
        function getEstadoBadge(estado) {
            var badges = {
                'Pendiente': '<span class="badge" style="background-color: #ffc107; color: #000;"><i class="bi bi-clock me-1"></i>Pendiente</span>',
                'Confirmada': '<span class="badge" style="background-color: #0d6efd;"><i class="bi bi-check-circle me-1"></i>Confirmada</span>',
                'EnProceso': '<span class="badge" style="background-color: #17a2b8;"><i class="bi bi-play-circle me-1"></i>En Proceso</span>',
                'Completada': '<span class="badge" style="background-color: #198754;"><i class="bi bi-check2-all me-1"></i>Completada</span>',
                'Cancelada': '<span class="badge" style="background-color: #dc3545;"><i class="bi bi-x-circle me-1"></i>Cancelada</span>'
            };
            return badges[estado] || '<span class="badge bg-secondary">' + estado + '</span>';
        }
    </script>
}
