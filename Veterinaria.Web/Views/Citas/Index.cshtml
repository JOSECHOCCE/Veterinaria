@model X.PagedList.IPagedList<Veterinaria.Web.Models.Dto.CitaDto>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Agenda de Citas";
    var esAdmin = ViewBag.EsAdmin ?? false;
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Gestione las citas médicas y servicios programados</p>
    </div>
    <div class="flex gap-sm">
        @if (esAdmin)
        {
            <a asp-action="Calendario" class="flex items-center gap-sm bg-surface text-primary border border-outline-variant px-md py-sm rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-colors shadow-sm text-decoration-none">
                <span class="material-symbols-outlined">calendar_month</span>
                Ver Calendario
            </a>
        }
        <a asp-action="Create" class="flex items-center gap-sm bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm text-decoration-none">
            <span class="material-symbols-outlined">add</span>
            Nueva Cita
        </a>
    </div>
</div>

<!-- Filtros -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm mb-lg p-md">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-5 gap-md items-end">
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Estado</label>
            <select name="estado" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Estados">
                <option value="">-- Todos --</option>
            </select>
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Veterinario</label>
            <select name="veterinarioId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="@ViewBag.Veterinarios">
                <option value="">-- Todos --</option>
            </select>
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Desde</label>
            <input type="date" name="fechaDesde" value="@ViewBag.CurrentFechaDesde" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Hasta</label>
            <input type="date" name="fechaHasta" value="@ViewBag.CurrentFechaHasta" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 bg-surface-variant text-on-surface px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-high transition-colors">Filtrar</button>
            <a asp-action="Index" class="bg-surface text-on-surface border border-outline-variant px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-low transition-colors text-center">Limpiar</a>
        </div>
    </form>
</div>

<!-- Tabla de citas -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm opacity-50">event_busy</span>
            <p class="font-headline-md text-headline-md">No se encontraron citas programadas.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="p-4 font-label-md text-label-md text-on-surface">Fecha/Hora</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Paciente y Propietario</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Veterinario</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Servicio</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface text-center">Estado</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @{
                        DateTime? ultimaFecha = null;
                    }
                    @foreach (var cita in Model)
                    {
                        var fechaCita = cita.FechaHora.Date;
                        
                        @if (ultimaFecha != fechaCita)
                        {
                            <tr class="bg-surface-container-highest">
                                <td colspan="6" class="p-3 font-label-md text-label-md text-on-surface font-bold flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm">calendar_month</span>
                                    @cita.FechaHora.ToString("dddd, dd 'de' MMMM 'de' yyyy")
                                </td>
                            </tr>
                            ultimaFecha = fechaCita;
                        }

                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4">
                                <p class="font-body-md text-body-md text-on-surface font-bold">@cita.FechaHora.ToString("HH:mm")</p>
                            </td>
                            <td class="p-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-xl">pets</span>
                                    <div>
                                        <p class="font-body-md text-body-md text-on-surface font-semibold">@cita.MascotaNombre</p>
                                        <p class="text-xs text-on-surface-variant flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">person</span> @(cita.PropietarioNombre ?? "Sin propietario")
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-secondary text-lg">medical_services</span>
                                    <span class="font-body-md text-body-md text-on-surface">@cita.VeterinarioNombre</span>
                                </div>
                            </td>
                            <td class="p-4">
                                <span class="font-label-sm text-label-sm text-on-primary-container bg-primary-container px-2 py-1 rounded-full">@cita.ServicioNombre</span>
                            </td>
                            <td class="p-4 text-center">
                                @{
                                    var badgeClass = cita.Estado switch
                                    {
                                        "Completada" => "bg-secondary-container text-on-secondary-container",
                                        "Confirmada" => "bg-primary-container text-on-primary-container",
                                        "EnProceso" => "bg-tertiary-container text-on-tertiary-container",
                                        "Cancelada" => "bg-error-container text-on-error-container",
                                        _ => "bg-surface-variant text-on-surface"
                                    };
                                }
                                <span class="font-label-sm text-label-sm px-3 py-1 rounded-full @badgeClass">@cita.Estado</span>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a asp-action="Details" asp-route-id="@cita.Id" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Ver detalles">
                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                    </a>
                                    @if (esAdmin && cita.Estado != "Completada" && cita.Estado != "Cancelada")
                                    {
                                        <a asp-action="Edit" asp-route-id="@cita.Id" class="text-tertiary hover:bg-tertiary-container p-2 rounded-full transition-colors" title="Editar">
                                            <span class="material-symbols-outlined text-lg">edit</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div class="bg-surface-container-low p-md border-t border-outline-variant flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-on-surface-variant">
                Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount citas
            </div>
            <div>
                <!-- Tailwind Pagination Fix -->
                <style>
                    .pagination { display: flex; list-style: none; gap: 4px; margin: 0; padding: 0; }
                    .page-item .page-link { padding: 4px 12px; border-radius: 4px; border: 1px solid #c3c6d5; color: #071e27; text-decoration: none; font-size: 14px; background: #f3faff; }
                    .page-item.active .page-link { background: #003c90; color: #ffffff; border-color: #003c90; }
                    .page-item.disabled .page-link { opacity: 0.5; pointer-events: none; }
                    .page-item:not(.active):not(.disabled) .page-link:hover { background: #cfe6f2; }
                </style>
                @Html.PagedListPager(Model, page => Url.Action("Index", new 
                { 
                    page, 
                    estado = ViewBag.CurrentEstado, 
                    veterinarioId = ViewBag.CurrentVeterinarioId,
                    fechaDesde = ViewBag.CurrentFechaDesde,
                    fechaHasta = ViewBag.CurrentFechaHasta
                }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    UlElementClasses = new[] { "pagination" }
                })
            </div>
        </div>
    }
</div>
