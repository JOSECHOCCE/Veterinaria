@model IEnumerable<Veterinaria.Domain.Entities.Triage>
@{
    ViewData["Title"] = "Cola de Atención y Triage";
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Gestión de emergencias y pacientes en espera</p>
    </div>
    <a asp-action="Create" class="flex items-center gap-sm bg-error text-on-error px-md py-sm rounded-full font-label-md text-label-md hover:opacity-90 transition-opacity shadow-sm text-decoration-none">
        <span class="material-symbols-outlined">emergency</span>
        Registrar Emergencia
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-xl">
    <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-primary text-3xl">groups</span>
            <span class="font-label-sm text-label-sm text-secondary bg-secondary-container px-xs py-[2px] rounded-DEFAULT">Total</span>
        </div>
        <div>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">@ViewBag.TotalEsperando</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Pacientes esperando atención</p>
        </div>
    </div>
    <div class="bg-error-container p-md rounded-xl border border-error shadow-sm flex flex-col justify-between animate-pulse">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-error text-3xl">warning</span>
            <span class="font-label-sm text-label-sm text-on-error bg-error px-xs py-[2px] rounded-DEFAULT">Crítico</span>
        </div>
        <div>
            <h3 class="font-headline-xl text-headline-xl text-on-error-container">@ViewBag.TotalEmergencias</h3>
            <p class="font-body-md text-body-md text-on-error-container">Emergencias activas (N1)</p>
        </div>
    </div>
</div>

<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm opacity-50">check_circle</span>
            <p class="font-headline-md text-headline-md">No hay pacientes en cola</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var isEmergency = item.Nivel == "N1";
            var bgClass = isEmergency ? "bg-error-container/20 border-l-4 border-error" : 
                          item.Nivel == "N2" ? "border-l-4 border-tertiary" : "border-l-4 border-primary";
            var iconClass = isEmergency ? "text-error" : "text-primary";
            var badgeBg = isEmergency ? "bg-error text-on-error" : 
                          item.Nivel == "N2" ? "bg-tertiary-container text-on-tertiary-container" : "bg-surface-variant text-on-surface";
            var badgeText = isEmergency ? "Emergencia (N1)" : 
                            item.Nivel == "N2" ? "Urgente (N2)" : "No Urgente (N3)";

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-md border-b border-outline-variant hover:bg-surface-container-low transition-colors @bgClass gap-4">
                <div class="flex items-center gap-md">
                    <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center border border-outline-variant shrink-0">
                        <span class="material-symbols-outlined @iconClass">pets</span>
                    </div>
                    <div>
                        <h4 class="font-headline-md text-headline-md text-on-surface">@item.Mascota.Nombre</h4>
                        <p class="font-body-md text-body-md text-on-surface-variant">@item.Mascota.Especie • @item.MotivoConsulta</p>
                        <p class="text-xs text-outline mt-1">Registrado: @item.FechaRegistro.ToString("HH:mm") (@item.TiempoEsperaEstimadoMin min est.)</p>
                    </div>
                </div>
                <div class="flex flex-col sm:items-end gap-2 w-full sm:w-auto">
                    <span class="font-label-sm text-label-sm px-xs py-[2px] rounded-DEFAULT @badgeBg inline-block w-max">@badgeText</span>
                    <p class="font-body-md text-body-md @(isEmergency ? "text-error font-semibold" : "text-on-surface-variant")">@item.Consultorio</p>
                    
                    <form asp-action="CambiarEstado" method="post" class="mt-2 flex gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        @if (item.Estado == "EnEspera")
                        {
                            <input type="hidden" name="nuevoEstado" value="EnAtencion" />
                            <button type="submit" class="bg-primary text-on-primary px-3 py-1 rounded-full text-xs font-semibold">Atender</button>
                        }
                        else if (item.Estado == "EnAtencion")
                        {
                            <input type="hidden" name="nuevoEstado" value="Atendido" />
                            <button type="submit" class="bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-semibold">Finalizar</button>
                        }
                    </form>
                </div>
            </div>
        }
    }
</div>
