@model Veterinaria.Domain.Entities.Triage
@{
    ViewData["Title"] = "Registrar Triage";
}

<div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Evalúe el estado del paciente para asignarle una prioridad.</p>
        <a asp-action="Cola" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver a la cola
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm p-lg">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-error mb-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-md">
                <div class="col-span-full">
                    <label asp-for="MascotaId" class="block font-label-md text-label-md text-on-surface mb-xs">Paciente (Mascota)</label>
                    <select asp-for="MascotaId" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" asp-items="ViewBag.Mascotas">
                        <option value="">-- Seleccione el Paciente --</option>
                    </select>
                    <span asp-validation-for="MascotaId" class="text-error text-xs"></span>
                </div>

                <div class="col-span-full">
                    <label asp-for="Nivel" class="block font-label-md text-label-md text-on-surface mb-xs">Nivel de Prioridad (Triage)</label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <label class="flex items-center p-3 border border-error bg-error-container/10 rounded-md cursor-pointer hover:bg-error-container/20">
                            <input type="radio" asp-for="Nivel" value="N1" class="text-error focus:ring-error" />
                            <div class="ml-3">
                                <span class="block font-semibold text-error">N1 - Emergencia</span>
                                <span class="text-xs text-on-surface-variant">Riesgo vital inminente</span>
                            </div>
                        </label>
                        <label class="flex items-center p-3 border border-tertiary bg-tertiary-container/10 rounded-md cursor-pointer hover:bg-tertiary-container/20">
                            <input type="radio" asp-for="Nivel" value="N2" class="text-tertiary focus:ring-tertiary" />
                            <div class="ml-3">
                                <span class="block font-semibold text-tertiary">N2 - Urgente</span>
                                <span class="text-xs text-on-surface-variant">Requiere atención rápida</span>
                            </div>
                        </label>
                        <label class="flex items-center p-3 border border-primary bg-primary-container/10 rounded-md cursor-pointer hover:bg-primary-container/20">
                            <input type="radio" asp-for="Nivel" value="N3" class="text-primary focus:ring-primary" checked />
                            <div class="ml-3">
                                <span class="block font-semibold text-primary">N3 - No Urgente</span>
                                <span class="text-xs text-on-surface-variant">Estable, puede esperar</span>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="Nivel" class="text-error text-xs"></span>
                </div>

                <div class="col-span-full">
                    <label asp-for="MotivoConsulta" class="block font-label-md text-label-md text-on-surface mb-xs">Motivo Principal</label>
                    <input asp-for="MotivoConsulta" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Ej. Atropello, Vómitos persistentes..." />
                    <span asp-validation-for="MotivoConsulta" class="text-error text-xs"></span>
                </div>

                <div class="col-span-full">
                    <label asp-for="Sintomas" class="block font-label-md text-label-md text-on-surface mb-xs">Síntomas Observados</label>
                    <textarea asp-for="Sintomas" rows="3" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Describa el cuadro clínico inicial"></textarea>
                </div>

                <div>
                    <label asp-for="Temperatura" class="block font-label-md text-label-md text-on-surface mb-xs">Temperatura (°C)</label>
                    <input asp-for="Temperatura" type="number" step="0.1" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                </div>

                <div>
                    <label asp-for="FrecuenciaCardiaca" class="block font-label-md text-label-md text-on-surface mb-xs">Frecuencia Cardíaca (lpm)</label>
                    <input asp-for="FrecuenciaCardiaca" type="number" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-md border-t border-outline-variant">
                <a asp-action="Cola" class="px-md py-sm rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">Cancelar</a>
                <button type="submit" class="bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Registrar en Cola
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
