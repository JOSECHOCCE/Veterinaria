@model Veterinaria.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Principal";
}

<!-- Header & Primary Actions -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Resumen de actividad diaria</p>
    </div>
    <a asp-controller="Triage" asp-action="Create" class="flex items-center gap-sm bg-error text-on-error px-md py-sm rounded-full font-label-md text-label-md hover:opacity-90 transition-opacity shadow-sm text-decoration-none">
        <span class="material-symbols-outlined">local_hospital</span>
        Nueva Emergencia
    </a>
</div>

<!-- Metrics Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-md mb-xl">
    <!-- Metric 1: Citas del día -->
    <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-primary text-3xl">calendar_month</span>
            <span class="font-label-sm text-label-sm text-secondary bg-secondary-container px-xs py-[2px] rounded-DEFAULT">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
        <div>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">@Model.CitasHoyTotal</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Citas del día (@Model.CitasHoyCompletadas completadas)</p>
        </div>
    </div>

    <!-- Metric 2: Pacientes en espera/proceso -->
    <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-tertiary text-3xl">hourglass_empty</span>
            <span class="font-label-sm text-label-sm text-tertiary bg-tertiary-container text-on-tertiary px-xs py-[2px] rounded-DEFAULT">Atención Requerida</span>
        </div>
        <div>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">@(Model.CitasHoyPendientes + Model.CitasHoyEnProceso)</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Pacientes en espera o proceso</p>
        </div>
    </div>

    <!-- Metric 3: Ingresos del mes -->
    <div class="bg-surface-container-highest p-md rounded-xl border border-outline shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-primary text-3xl">payments</span>
            <span class="font-label-sm text-label-sm text-on-primary bg-primary px-xs py-[2px] rounded-DEFAULT">Confirmados: @Model.PagosConfirmadosMes</span>
        </div>
        <div>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">@Model.IngresosMes.ToString("C")</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Ingresos del mes</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-md mb-xl">
    <!-- Próximas Citas -->
    <div>
        <div class="flex justify-between items-center mb-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">Próximas Citas</h3>
            <a class="font-label-md text-label-md text-primary hover:underline" asp-controller="Citas" asp-action="Index">Ver Agenda</a>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden h-[400px] overflow-y-auto">
            @if (!Model.ProximasCitas.Any())
            {
                <div class="flex flex-col items-center justify-center h-full text-on-surface-variant p-lg">
                    <span class="material-symbols-outlined text-6xl mb-sm opacity-50">calendar_x</span>
                    <p>No hay citas programadas para hoy.</p>
                </div>
            }
            else
            {
                @foreach (var cita in Model.ProximasCitas)
                {
                    <div class="flex items-center justify-between p-md border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-md">
                            <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center border border-outline-variant">
                                <span class="material-symbols-outlined text-primary">pets</span>
                            </div>
                            <div>
                                <h4 class="font-headline-md text-headline-md text-on-surface">@cita.MascotaNombre</h4>
                                <p class="font-body-md text-body-md text-on-surface-variant">@cita.ServicioNombre</p>
                            </div>
                        </div>
                        <div class="text-right flex flex-col items-end gap-xs">
                            <span class="font-label-sm text-label-sm text-on-surface bg-surface-variant px-xs py-[2px] rounded-DEFAULT">@cita.Estado</span>
                            <p class="font-body-md text-body-md text-primary font-semibold">@cita.FechaHora.ToString("HH:mm")</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Veterinarios más ocupados -->
    <div>
        <div class="flex justify-between items-center mb-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">Top Veterinarios (Semana)</h3>
            <a class="font-label-md text-label-md text-primary hover:underline" asp-controller="Veterinarios" asp-action="Index">Ver Equipo</a>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden h-[400px] overflow-y-auto">
            @if (!Model.VeterinariosMasOcupados.Any())
            {
                <div class="flex flex-col items-center justify-center h-full text-on-surface-variant p-lg">
                    <span class="material-symbols-outlined text-6xl mb-sm opacity-50">person_off</span>
                    <p>No hay actividad registrada.</p>
                </div>
            }
            else
            {
                @foreach (var vet in Model.VeterinariosMasOcupados)
                {
                    <div class="flex items-center justify-between p-md border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                        <div class="flex items-center gap-md">
                            <div class="w-12 h-12 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center">
                                <span class="material-symbols-outlined">person</span>
                            </div>
                            <div>
                                <h4 class="font-headline-md text-headline-md text-on-surface">@vet.Nombre</h4>
                                <p class="font-body-md text-body-md text-on-surface-variant">@(vet.Especialidad ?? "General")</p>
                            </div>
                        </div>
                        <div class="text-right flex flex-col items-end gap-xs">
                            <span class="font-label-sm text-label-sm text-on-primary-container bg-primary-container px-xs py-[2px] rounded-DEFAULT">@vet.CitasSemana citas esta semana</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">@vet.CitasMes este mes</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Chart Area -->
<div class="mb-xl">
    <h3 class="font-headline-md text-headline-md text-on-surface mb-md">Servicios más Solicitados</h3>
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm p-md">
        <canvas id="serviciosChart" height="80"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const serviciosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiciosMasSolicitados.Select(s => new { s.Nombre, s.CantidadCitas, s.Ingresos })));
        
        const serviciosCtx = document.getElementById('serviciosChart').getContext('2d');
        new Chart(serviciosCtx, {
            type: 'bar',
            data: {
                labels: serviciosData.map(s => s.Nombre),
                datasets: [{
                    label: 'Cantidad de Citas',
                    data: serviciosData.map(s => s.CantidadCitas),
                    backgroundColor: 'rgba(15, 82, 186, 0.85)', // primary-container color
                    borderColor: '#0f52ba',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#1e333c', // inverse-surface
                        titleColor: '#ffffff',
                        bodyColor: '#dff4ff', // inverse-on-surface
                        callbacks: {
                            afterLabel: function(context) {
                                const ingresos = serviciosData[context.dataIndex].Ingresos;
                                return 'Ingresos: ' + new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(ingresos);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}
