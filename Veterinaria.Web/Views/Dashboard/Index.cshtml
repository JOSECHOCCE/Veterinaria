@model Veterinaria.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - Panel de Administración";
}

<div class="container-fluid">
    <!-- Hero Dashboard -->
    <div class="hero-dashboard mb-4 animate-on-scroll">
        <div class="row align-items-center">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="hero-dashboard-content">
                    <h1 class="display-6 fw-bold mb-3"><i class="bi bi-speedometer2 me-2"></i>Panel de Administración</h1>
                    <p class="lead mb-4 fw-medium opacity-75">Gestione citas, tratamientos, pagos y equipo desde un panel optimizado para tu flujo diario.</p>
                    <div class="d-flex flex-wrap gap-3 hero-stats">
                        <div class="hero-stat">
                            <span class="hero-stat-value">@Model.TotalMascotas</span>
                            <span class="hero-stat-label">Mascotas</span>
                        </div>
                        <div class="hero-stat">
                            <span class="hero-stat-value">@Model.TotalVeterinarios</span>
                            <span class="hero-stat-label">Veterinarios</span>
                        </div>
                        <div class="hero-stat">
                            <span class="hero-stat-value">@Model.TotalUsuarios</span>
                            <span class="hero-stat-label">Clientes</span>
                        </div>
                        <div class="hero-stat">
                            <span class="hero-stat-value">@Model.TotalServicios</span>
                            <span class="hero-stat-label">Servicios</span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <span class="badge rounded-pill bg-light text-dark px-3 py-2 shadow-sm">
                            <i class="bi bi-calendar-date me-1 text-primary"></i>@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="hero-illustration-wrapper position-relative">
                    <img src="~/images/veterinaria-banner.jpg" alt="Veterinaria" class="hero-illustration img-fluid" onerror="this.style.display='none'" />
                    <div class="hero-illustration-fallback">
                        <div class="fallback-circle gradient-bg"></div>
                        <i class="bi bi-heart-pulse display-4 text-white position-absolute top-50 start-50 translate-middle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-bg-shape"></div>
    </div>

    <!-- Accesos Rápidos a Módulos -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Accesos Rápidos</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-primary bg-gradient text-white text-center py-3 quick-access-card">
                                    <i class="bi bi-people fs-1"></i>
                                    <h6 class="mt-2 mb-0">Clientes</h6>
                                    <small>@Model.TotalUsuarios registrados</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Mascotas" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-success bg-gradient text-white text-center py-3 quick-access-card">
                                    <i class="bi bi-heart-pulse fs-1"></i>
                                    <h6 class="mt-2 mb-0">Mascotas</h6>
                                    <small>@Model.TotalMascotas registradas</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Veterinarios" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-info bg-gradient text-white text-center py-3 quick-access-card">
                                    <i class="bi bi-person-badge fs-1"></i>
                                    <h6 class="mt-2 mb-0">Veterinarios</h6>
                                    <small>@Model.TotalVeterinarios activos</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Servicios" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-warning bg-gradient text-dark text-center py-3 quick-access-card">
                                    <i class="bi bi-clipboard-pulse fs-1"></i>
                                    <h6 class="mt-2 mb-0">Servicios</h6>
                                    <small>@Model.TotalServicios activos</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Citas" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-secondary bg-gradient text-white text-center py-3 quick-access-card">
                                    <i class="bi bi-calendar-check fs-1"></i>
                                    <h6 class="mt-2 mb-0">Citas</h6>
                                    <small>@Model.CitasHoyTotal hoy</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <a asp-controller="Pagos" asp-action="Index" class="text-decoration-none">
                                <div class="card h-100 border-0 bg-danger bg-gradient text-white text-center py-3 quick-access-card">
                                    <i class="bi bi-credit-card fs-1"></i>
                                    <h6 class="mt-2 mb-0">Pagos</h6>
                                    <small>@Model.PagosPendientesCount pendientes</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Citas de hoy e Ingresos -->
    <div class="row mb-4">
        <!-- Citas de Hoy -->
        <div class="col-xl-8 col-lg-7">
            <div class="glass-card shadow-lg mb-4 animate-on-scroll">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                    <h5 class="m-0 text-white"><i class="bi bi-calendar-check"></i> Citas de Hoy</h5>
                    <span class="badge bg-white text-primary fs-6 px-3 py-2 rounded-pill"><strong>@Model.CitasHoyTotal</strong> citas</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col">
                            <div class="mini-stat-card stat-secondary">
                                <div class="mini-stat-icon">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div class="mini-stat-content">
                                    <div class="counter" data-target="@Model.CitasHoyPendientes">0</div>
                                    <small>Pendientes</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mini-stat-card stat-primary">
                                <div class="mini-stat-icon">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="mini-stat-content">
                                    <div class="counter" data-target="@Model.CitasHoyConfirmadas">0</div>
                                    <small>Confirmadas</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mini-stat-card stat-warning">
                                <div class="mini-stat-icon">
                                    <i class="bi bi-arrow-repeat"></i>
                                </div>
                                <div class="mini-stat-content">
                                    <div class="counter" data-target="@Model.CitasHoyEnProceso">0</div>
                                    <small>En Proceso</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mini-stat-card stat-success">
                                <div class="mini-stat-icon">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                                <div class="mini-stat-content">
                                    <div class="counter" data-target="@Model.CitasHoyCompletadas">0</div>
                                    <small>Completadas</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mini-stat-card stat-danger">
                                <div class="mini-stat-icon">
                                    <i class="bi bi-x-circle"></i>
                                </div>
                                <div class="mini-stat-content">
                                    <div class="counter" data-target="@Model.CitasHoyCanceladas">0</div>
                                    <small>Canceladas</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-2"><i class="bi bi-calendar-week text-primary"></i> Esta Semana</h6>
                            <p class="mb-0 small">
                                <span class="badge bg-primary me-2">@Model.CitasSemanaTotal Total</span>
                                <span class="badge bg-success me-2">@Model.CitasSemanaCompletadas Completadas</span>
                                <span class="badge bg-warning text-dark">@Model.CitasSemanaPendientes Pendientes</span>
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Citas" asp-action="Index" class="btn btn-primary btn-sm px-4">
                                Ver todas <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingresos y Pagos -->
        <div class="col-xl-4 col-lg-5">
            <div class="glass-card shadow-lg mb-4 animate-on-scroll">
                <div class="card-header py-3 text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none;">
                    <h5 class="m-0"><i class="bi bi-cash-coin"></i> Ingresos del Mes</h5>
                </div>
                <div class="card-body text-center p-4">
                    <div class="position-relative">
                        <div class="income-circle mb-3">
                            <i class="bi bi-currency-dollar text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h1 class="display-4 text-success mb-2 fw-bold">@Model.IngresosMes.ToString("C")</h1>
                        <p class="text-muted mb-4">
                            <i class="bi bi-check-circle text-success"></i> 
                            @Model.PagosConfirmadosMes pagos confirmados
                        </p>
                    </div>
                    <hr class="my-4" />
                    <div class="pending-payments-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-warning">
                                <i class="bi bi-exclamation-triangle-fill"></i> Pendientes
                            </h6>
                            <span class="badge bg-warning text-dark">@Model.PagosPendientesCount</span>
                        </div>
                        <h3 class="text-warning mb-0 fw-bold">@Model.PagosPendientesTotal.ToString("C")</h3>
                        <small class="text-muted">Por confirmar</small>
                    </div>
                </div>
                <div class="card-footer border-0 p-3" style="background: linear-gradient(to right, #ffeaa7, #fdcb6e);">
                    <a asp-controller="Pagos" asp-action="Index" asp-route-estado="Pendiente" class="btn btn-dark btn-sm w-100 fw-bold">
                        <i class="bi bi-eye"></i> Ver Pagos Pendientes
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Gráfico de Servicios (ancho completo) -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 animate-on-scroll">
                <div class="card-header py-3 dashboard-card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="m-0 text-white"><i class="bi bi-bar-chart-fill me-2"></i>Servicios más Solicitados (Este Mes)</h5>
                </div>
                <div class="card-body p-4">
                    <canvas id="serviciosChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 4: Veterinarios y Próximas citas -->
    <div class="row g-4 mb-4">
        <!-- Veterinarios más ocupados -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 animate-on-scroll">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                    <h5 class="m-0 text-white"><i class="bi bi-person-badge-fill me-2"></i>Veterinarios más Ocupados</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.VeterinariosMasOcupados.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-person-x display-4 text-muted opacity-50"></i>
                            <p class="text-muted mt-2 mb-0">No hay datos disponibles</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Veterinario</th>
                                        <th>Especialidad</th>
                                        <th class="text-center">Semana</th>
                                        <th class="text-center pe-4">Mes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vet in Model.VeterinariosMasOcupados)
                                    {
                                        <tr>
                                            <td class="ps-4"><strong>@vet.Nombre</strong></td>
                                            <td><span class="badge bg-light text-secondary">@(vet.Especialidad ?? "General")</span></td>
                                            <td class="text-center">
                                                <span class="badge bg-primary rounded-pill px-3">@vet.CitasSemana</span>
                                            </td>
                                            <td class="text-center pe-4">
                                                <span class="badge bg-info rounded-pill px-3">@vet.CitasMes</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Próximas citas -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100 animate-on-scroll">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);">
                    <h5 class="m-0 text-white"><i class="bi bi-clock-fill me-2"></i>Próximas Citas</h5>
                    <span class="badge bg-white text-dark rounded-pill px-3">3 días</span>
                </div>
                <div class="card-body p-3" style="max-height: 320px; overflow-y: auto;">
                    @if (Model.ProximasCitas.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x display-4 text-muted opacity-50"></i>
                            <p class="text-muted mt-2 mb-0">No hay citas programadas</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var cita in Model.ProximasCitas)
                        {
                            var esHoy = cita.FechaHora.Date == DateTime.Today;
                            var borderClass = esHoy ? "border-start border-4 border-warning" : "border-start border-4 border-primary";
                            var badgeClass = cita.Estado == "Confirmada" ? "bg-primary" : 
                                            cita.Estado == "Completada" ? "bg-success" : 
                                            cita.Estado == "EnProceso" ? "bg-warning text-dark" : "bg-secondary";
                            
                            <div class="d-flex align-items-center p-2 mb-2 rounded-2 bg-light @borderClass cita-item">
                                <div class="flex-shrink-0 text-center me-3" style="min-width: 50px;">
                                    <div class="fw-bold text-dark">@cita.FechaHora.ToString("HH:mm")</div>
                                    <small class="text-muted">@cita.FechaHora.ToString("dd/MM")</small>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-dark">@cita.MascotaNombre</strong>
                                        @if (esHoy)
                                        {
                                            <span class="badge bg-warning text-dark">HOY</span>
                                        }
                                        else
                                        {
                                            <span class="badge @badgeClass">@cita.Estado</span>
                                        }
                                    </div>
                                    <small class="text-muted d-block">
                                        <i class="bi bi-person-badge"></i> @cita.VeterinarioNombre · 
                                        <span class="text-primary">@cita.ServicioNombre</span>
                                    </small>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="card-footer bg-transparent border-0 p-3">
                    <a asp-controller="Citas" asp-action="Create" class="btn btn-success w-100">
                        <i class="bi bi-plus-circle me-2"></i>Nueva Cita
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de barras - Servicios más solicitados
        const serviciosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiciosMasSolicitados.Select(s => new { s.Nombre, s.CantidadCitas, s.Ingresos })));
        
        const serviciosCtx = document.getElementById('serviciosChart').getContext('2d');
        new Chart(serviciosCtx, {
            type: 'bar',
            data: {
                labels: serviciosData.map(s => s.Nombre),
                datasets: [{
                    label: 'Cantidad de Citas',
                    data: serviciosData.map(s => s.CantidadCitas),
                    backgroundColor: [
                        'rgba(102, 126, 234, 0.85)',
                        'rgba(118, 75, 162, 0.85)',
                        'rgba(237, 100, 166, 0.85)',
                        'rgba(255, 154, 158, 0.85)',
                        'rgba(250, 208, 196, 0.85)'
                    ],
                    borderColor: [
                        'rgb(102, 126, 234)',
                        'rgb(118, 75, 162)',
                        'rgb(237, 100, 166)',
                        'rgb(255, 154, 158)',
                        'rgb(250, 208, 196)'
                    ],
                    borderWidth: 2,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart',
                    onComplete: function() {
                        this.options.animation.duration = 500;
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        borderRadius: 8,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            afterLabel: function(context) {
                                const ingresos = serviciosData[context.dataIndex].Ingresos;
                                return 'Ingresos: ' + new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(ingresos);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    </script>
}

<style>
    /* Tarjetas de acceso rápido */
    .quick-access-card {
        transition: all 0.3s cubic-bezier(.4,0,.2,1);
        border-radius: 1rem;
        cursor: pointer;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    
    .quick-access-card:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18) !important;
    }
    
    .quick-access-card i {
        transition: transform 0.3s ease;
        font-size: 2.5rem !important;
    }
    
    .quick-access-card:hover i {
        transform: scale(1.15);
    }
    
    /* Items de próximas citas */
    .cita-item {
        transition: all 0.25s ease;
    }
    
    .cita-item:hover {
        background-color: #e0e7ff !important;
        transform: translateX(4px);
    }
    
    /* Dashboard card headers */
    .dashboard-card-header {
        border-radius: 0.5rem 0.5rem 0 0;
    }
</style>
