@model IEnumerable<Veterinaria.Domain.Entities.Consentimiento>
@{
    ViewData["Title"] = "Gestión de Consentimientos";
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Documentos legales y autorizaciones de pacientes</p>
    </div>
    <a asp-action="Create" class="flex items-center gap-sm bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm text-decoration-none">
        <span class="material-symbols-outlined">post_add</span>
        Nuevo Consentimiento
    </a>
</div>

<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant">
                    <th class="p-4 font-label-md text-label-md text-on-surface">Documento ID</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface">Propietario / Paciente</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface">Tipo</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface">Fecha</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-center">Estado</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="p-xl text-center text-on-surface-variant">
                            <span class="material-symbols-outlined text-4xl mb-2 opacity-50 block">description</span>
                            No hay consentimientos registrados
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4 font-body-md text-body-md text-on-surface font-semibold">
                                @item.DocumentoId
                            </td>
                            <td class="p-4">
                                <p class="font-body-md text-body-md text-on-surface">@item.NombrePropietario</p>
                                <p class="text-xs text-on-surface-variant">@(item.Mascota?.Nombre ?? item.NombrePaciente ?? "N/A")</p>
                            </td>
                            <td class="p-4 font-body-md text-body-md text-on-surface-variant">
                                @item.TipoConsentimiento
                            </td>
                            <td class="p-4 font-body-md text-body-md text-on-surface-variant">
                                @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="p-4 text-center">
                                @if (item.Aceptado)
                                {
                                    <span class="inline-flex items-center gap-1 bg-secondary-container text-on-secondary-container px-2 py-1 rounded-full text-xs font-semibold">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Firmado
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 bg-error-container text-on-error-container px-2 py-1 rounded-full text-xs font-semibold">
                                        <span class="material-symbols-outlined text-[14px]">pending_actions</span> Pendiente
                                    </span>
                                }
                            </td>
                            <td class="p-4 text-right">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors inline-block" title="Ver Detalles">
                                    <span class="material-symbols-outlined text-lg">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
