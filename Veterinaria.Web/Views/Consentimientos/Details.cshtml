@model Veterinaria.Domain.Entities.Consentimiento
@{
    ViewData["Title"] = "Detalle de Consentimiento";
}

<div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Documento @Model.DocumentoId</h2>
        <a asp-action="Index" class="flex items-center gap-1 font-label-md text-label-md text-primary hover:underline">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden mb-xl">
        <div class="bg-surface-container border-b border-outline-variant p-md flex justify-between items-center">
            <div class="flex items-center gap-sm">
                <span class="material-symbols-outlined text-primary text-3xl">verified_user</span>
                <div>
                    <h3 class="font-headline-md text-headline-md text-on-surface">@Model.TipoConsentimiento</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">Generado el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            <div>
                @if (Model.Aceptado)
                {
                    <span class="inline-flex items-center gap-1 bg-secondary-container text-on-secondary-container px-3 py-1.5 rounded-full text-sm font-semibold">
                        <span class="material-symbols-outlined text-base">check_circle</span> Firmado
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 bg-error-container text-on-error-container px-3 py-1.5 rounded-full text-sm font-semibold">
                        <span class="material-symbols-outlined text-base">pending_actions</span> Pendiente
                    </span>
                }
            </div>
        </div>

        <div class="p-lg">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-md gap-x-xl mb-lg">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Propietario</p>
                    <p class="font-body-lg text-body-lg text-on-surface font-medium">@Model.NombrePropietario</p>
                    @if(Model.Usuario != null)
                    {
                        <p class="text-sm text-on-surface-variant mt-1">Usuario ID: @Model.Usuario.Id</p>
                    }
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Paciente</p>
                    <p class="font-body-lg text-body-lg text-on-surface font-medium">@(Model.Mascota?.Nombre ?? Model.NombrePaciente ?? "N/A")</p>
                    @if(Model.Mascota != null)
                    {
                        <p class="text-sm text-on-surface-variant mt-1">@Model.Mascota.Especie @(Model.Mascota.Raza != null ? $"- {Model.Mascota.Raza}" : "")</p>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Observaciones))
            {
                <div class="mb-lg p-md bg-surface-container-low rounded-lg border border-outline-variant">
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Observaciones y Condiciones Especiales</p>
                    <p class="font-body-md text-body-md text-on-surface whitespace-pre-wrap">@Model.Observaciones</p>
                </div>
            }

            <div class="border-t border-outline-variant pt-lg mt-md">
                <h4 class="font-headline-sm text-headline-sm text-on-surface mb-md">Firmas y Certificación</h4>
                
                @if (Model.Aceptado && Model.FechaAceptacion.HasValue)
                {
                    <div class="flex flex-col md:flex-row gap-lg">
                        <div class="flex-1 p-md border-2 border-dashed border-secondary rounded-lg bg-surface">
                            <p class="text-center font-handwriting text-2xl text-on-surface mb-2" style="font-family: 'Brush Script MT', cursive; transform: rotate(-2deg);">@Model.NombrePropietario</p>
                            <hr class="border-outline-variant mb-2"/>
                            <p class="text-center font-label-sm text-label-sm text-on-surface-variant">Firma Digital del Propietario</p>
                        </div>
                        <div class="flex-1 space-y-2">
                            <p class="font-body-sm text-body-sm"><span class="font-semibold">Fecha de firma:</span> @Model.FechaAceptacion.Value.ToString("dd/MM/yyyy HH:mm:ss")</p>
                            <p class="font-body-sm text-body-sm"><span class="font-semibold">IP Origen:</span> @(Model.IpOrigen ?? "Registrada en Clínica")</p>
                            <p class="font-body-sm text-body-sm"><span class="font-semibold">ID Documento:</span> @Model.DocumentoId</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-xl border-2 border-dashed border-outline-variant rounded-lg bg-surface-container-lowest text-center">
                        <span class="material-symbols-outlined text-4xl text-outline mb-2">edit_off</span>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4">El documento aún no ha sido firmado por el propietario.</p>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-sm bg-primary text-on-primary px-md py-sm rounded-full font-label-md text-label-md hover:bg-primary/90 transition-colors shadow-sm text-decoration-none">
                            <span class="material-symbols-outlined text-sm">edit</span>
                            Gestionar Firma
                        </a>
                    </div>
                }
            </div>
        </div>
        
        <div class="bg-surface-container-low p-md border-t border-outline-variant flex justify-end gap-3">
            <button onclick="window.print()" class="px-md py-sm rounded-full font-label-md text-label-md bg-surface border border-outline-variant text-on-surface hover:bg-surface-container-high transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">print</span> Imprimir
            </button>
            <a asp-action="Index" class="px-md py-sm rounded-full font-label-md text-label-md bg-primary text-on-primary hover:bg-primary/90 transition-colors">Volver a la Lista</a>
        </div>
    </div>
</div>
