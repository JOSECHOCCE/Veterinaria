@model IEnumerable<Veterinaria.Domain.Entities.Veterinario>

@{
    ViewData["Title"] = "Nuestros Veterinarios";
}

<!-- Hero Section -->
<section class="bg-success text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold">
                    <i class="bi bi-person-badge me-3"></i>Nuestro Equipo
                </h1>
                <p class="lead mb-0">
                    Conoce a los profesionales que cuidarán de tu mascota con dedicación y experiencia.
                </p>
            </div>
            <div class="col-lg-4 text-end d-none d-lg-block">
                <i class="bi bi-people display-1 opacity-50"></i>
            </div>
        </div>
    </div>
</section>

<!-- Veterinarios -->
<section class="py-5">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x display-1 text-muted"></i>
                <h3 class="text-muted mt-3">No hay veterinarios disponibles</h3>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var vet in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm vet-card-public text-center">
                            <div class="card-body p-4">
                                <div class="vet-avatar mx-auto mb-3">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                
                                <h5 class="card-title fw-bold mb-1">Dr(a). @vet.Nombre</h5>
                                
                                @if (!string.IsNullOrEmpty(vet.Especialidad))
                                {
                                    <span class="badge bg-primary mb-3">@vet.Especialidad</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary mb-3">Medicina General</span>
                                }
                                
                                <hr />
                                
                                <div class="text-start">
                                    @if (!string.IsNullOrEmpty(vet.Email))
                                    {
                                        <p class="mb-2">
                                            <i class="bi bi-envelope text-primary me-2"></i>
                                            <small>@vet.Email</small>
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(vet.Telefono))
                                    {
                                        <p class="mb-2">
                                            <i class="bi bi-telephone text-primary me-2"></i>
                                            <small>@vet.Telefono</small>
                                        </p>
                                    }
                                    <p class="mb-0">
                                        <i class="bi bi-clock text-primary me-2"></i>
                                        <small>@vet.HorarioInicio.ToString("hh\\:mm") - @vet.HorarioFin.ToString("hh\\:mm")</small>
                                    </p>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 p-4 pt-0">
                                <a asp-controller="Citas" asp-action="Create" 
                                   class="btn btn-outline-primary w-100">
                                    <i class="bi bi-calendar-plus me-2"></i>Agendar con este doctor
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- CTA -->
<section class="py-5 bg-light">
    <div class="container text-center">
        <h3 class="mb-3">¿Necesitas una consulta?</h3>
        <p class="text-muted mb-4">Agenda una cita con cualquiera de nuestros especialistas</p>
        <a asp-controller="Citas" asp-action="Create" class="btn btn-success btn-lg px-5">
            <i class="bi bi-calendar-check me-2"></i>Agendar Cita Ahora
        </a>
    </div>
</section>

<style>
    .vet-card-public {
        transition: all 0.3s ease;
        border-radius: 1rem;
    }
    
    .vet-card-public:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
    }
    
    .vet-avatar {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #198754, #20c997);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 3rem;
    }
</style>
