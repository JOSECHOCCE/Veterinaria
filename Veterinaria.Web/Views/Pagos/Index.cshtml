@model X.PagedList.IPagedList<Veterinaria.Web.Models.Dto.PagoDto>
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Gestión de Pagos";
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Historial de transacciones y facturación</p>
    </div>
    <a asp-action="Reporte" class="flex items-center gap-sm bg-surface text-primary border border-outline-variant px-md py-sm rounded-full font-label-md text-label-md hover:bg-surface-container-low transition-colors shadow-sm text-decoration-none">
        <span class="material-symbols-outlined">analytics</span>
        Ver Reporte Financiero
    </a>
</div>

<!-- Tarjetas de Resumen -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md mb-lg">
    <div class="bg-primary-container text-on-primary-container p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-primary text-3xl">account_balance_wallet</span>
            <span class="font-label-sm text-label-sm bg-primary text-on-primary px-xs py-[2px] rounded-DEFAULT">Total</span>
        </div>
        <div>
            <h6 class="font-label-md text-label-md uppercase tracking-wider opacity-80">Recaudado</h6>
            <h3 class="font-headline-xl text-headline-xl">S/. @(((decimal)(ViewBag.TotalGeneral ?? 0m)).ToString("N2"))</h3>
        </div>
    </div>
    
    <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-secondary text-3xl">credit_card</span>
            <span class="font-label-sm text-label-sm text-secondary bg-secondary-container px-xs py-[2px] rounded-DEFAULT">Electrónico</span>
        </div>
        <div>
            <h6 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Tarjeta</h6>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">S/. @(((decimal)(ViewBag.TotalTarjeta ?? 0m)).ToString("N2"))</h3>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-tertiary text-3xl">payments</span>
            <span class="font-label-sm text-label-sm text-tertiary bg-tertiary-container px-xs py-[2px] rounded-DEFAULT">Físico</span>
        </div>
        <div>
            <h6 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Efectivo</h6>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">S/. @(((decimal)(ViewBag.TotalEfectivo ?? 0m)).ToString("N2"))</h3>
        </div>
    </div>

    <div class="bg-surface-variant p-md rounded-xl border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start mb-sm">
            <span class="material-symbols-outlined text-on-surface-variant text-3xl">receipt_long</span>
            <span class="font-label-sm text-label-sm text-on-surface bg-surface px-xs py-[2px] rounded-DEFAULT border border-outline">Transacciones</span>
        </div>
        <div>
            <h6 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Total Pagos</h6>
            <h3 class="font-headline-xl text-headline-xl text-on-surface">@(ViewBag.TotalPagos ?? 0)</h3>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm mb-lg p-md">
    <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-5 gap-md items-end">
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Tipo de Pago</label>
            <select name="tipoPago" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                <option value="">-- Todos --</option>
                <option value="Completo" selected="@(ViewBag.CurrentTipoPago == "Completo")">Completo</option>
                <option value="Parcial" selected="@(ViewBag.CurrentTipoPago == "Parcial")">Parcial</option>
                <option value="Restante" selected="@(ViewBag.CurrentTipoPago == "Restante")">Restante</option>
            </select>
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Método de Pago</label>
            <select name="metodoPago" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                <option value="">-- Todos --</option>
                <option value="Tarjeta" selected="@(ViewBag.CurrentMetodoPago == "Tarjeta")">Tarjeta</option>
                <option value="Efectivo" selected="@(ViewBag.CurrentMetodoPago == "Efectivo")">Efectivo</option>
            </select>
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Desde</label>
            <input type="date" name="fechaDesde" value="@ViewBag.CurrentFechaDesde" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </div>
        <div>
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Hasta</label>
            <input type="date" name="fechaHasta" value="@ViewBag.CurrentFechaHasta" class="w-full bg-surface border border-outline-variant rounded-md px-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 bg-surface-variant text-on-surface px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-high transition-colors">Filtrar</button>
            <a asp-action="Index" class="bg-surface text-on-surface border border-outline-variant px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-low transition-colors text-center flex items-center justify-center">
                <span class="material-symbols-outlined text-sm">clear_all</span>
            </a>
        </div>
    </form>
</div>

<!-- Tabla de Pagos -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden mb-xl">
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm opacity-50">receipt_long</span>
            <p class="font-headline-md text-headline-md">No hay pagos registrados.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="p-4 font-label-md text-label-md text-on-surface">Referencia & Fecha</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Paciente / Servicio</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Tipo</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface">Método</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface text-right">Monto</th>
                        <th class="p-4 font-label-md text-label-md text-on-surface text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var pago in Model)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4">
                                <p class="font-mono text-sm bg-surface-variant text-on-surface-variant px-2 py-0.5 rounded inline-block mb-1">@pago.Referencia</p>
                                <div class="text-sm text-on-surface-variant flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                                    @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td class="p-4">
                                <p class="font-body-md text-body-md text-on-surface font-semibold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm text-primary">pets</span> @pago.MascotaNombre
                                </p>
                                <p class="text-xs text-on-surface-variant flex items-center gap-1 mt-0.5">
                                    <span class="material-symbols-outlined text-[14px]">medical_services</span> @pago.ServicioNombre
                                </p>
                            </td>
                            <td class="p-4">
                                @{
                                    var tipoBadge = pago.TipoPago switch
                                    {
                                        "Completo" => "bg-secondary-container text-on-secondary-container",
                                        "Parcial" => "bg-tertiary-container text-on-tertiary-container",
                                        "Restante" => "bg-primary-container text-on-primary-container",
                                        _ => "bg-surface-variant text-on-surface"
                                    };
                                }
                                <span class="font-label-sm text-label-sm px-2 py-1 rounded-full @tipoBadge">@pago.TipoPago</span>
                            </td>
                            <td class="p-4">
                                @if (pago.MetodoPago == "Tarjeta")
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary">credit_card</span>
                                        <span class="font-body-sm text-body-sm text-on-surface">****@pago.UltimosDigitosTarjeta</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-secondary">payments</span>
                                        <span class="font-body-sm text-body-sm text-on-surface">Efectivo</span>
                                    </div>
                                }
                            </td>
                            <td class="p-4 text-right">
                                <p class="font-headline-sm text-headline-sm text-on-surface">S/. @pago.Monto.ToString("N2")</p>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@pago.Id" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Ver detalles">
                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                    </a>
                                    <a asp-controller="PagoCita" asp-action="DescargarComprobante" asp-route-pagoId="@pago.Id" class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Descargar PDF">
                                        <span class="material-symbols-outlined text-lg">picture_as_pdf</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div class="bg-surface-container-low p-md border-t border-outline-variant flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="text-sm text-on-surface-variant">
                Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount pagos
            </div>
            <div>
                <style>
                    .pagination { display: flex; list-style: none; gap: 4px; margin: 0; padding: 0; }
                    .page-item .page-link { padding: 4px 12px; border-radius: 4px; border: 1px solid #c3c6d5; color: #071e27; text-decoration: none; font-size: 14px; background: #f3faff; }
                    .page-item.active .page-link { background: #003c90; color: #ffffff; border-color: #003c90; }
                    .page-item.disabled .page-link { opacity: 0.5; pointer-events: none; }
                    .page-item:not(.active):not(.disabled) .page-link:hover { background: #cfe6f2; }
                </style>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { 
                    page, 
                    tipoPago = ViewBag.CurrentTipoPago, 
                    metodoPago = ViewBag.CurrentMetodoPago,
                    fechaDesde = ViewBag.CurrentFechaDesde, 
                    fechaHasta = ViewBag.CurrentFechaHasta 
                }), new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    UlElementClasses = new[] { "pagination" }
                })
            </div>
        </div>
    }
</div>
