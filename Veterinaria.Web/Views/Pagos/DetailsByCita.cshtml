@{
    ViewData["Title"] = "Pagos de Cita";
    var cita = ViewBag.Cita as Veterinaria.Domain.Entities.Cita;
    var pagos = ViewBag.Pagos as List<Veterinaria.Domain.Entities.Pago>;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">
                    <i class="bi bi-receipt"></i> Pagos de la Cita #@cita?.Id
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>

            <!-- Información de la Cita -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Información de la Cita</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Mascota:</strong> @cita?.Mascota?.Nombre</p>
                            <p><strong>Propietario:</strong> @cita?.Mascota?.Usuario?.Nombre</p>
                            <p><strong>Servicio:</strong> @cita?.Servicio?.Nombre</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Veterinario:</strong> @cita?.Veterinario?.Nombre</p>
                            <p><strong>Fecha:</strong> @cita?.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                            <p><strong>Estado:</strong> <span class="badge bg-secondary">@cita?.Estado</span></p>
                        </div>
                    </div>
                    <hr />
                    <div class="row text-center">
                        <div class="col-4">
                            <small class="text-muted d-block">Total del Servicio</small>
                            <h4 class="text-primary">S/. @cita?.MontoTotal.ToString("N2")</h4>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">Total Pagado</small>
                            <h4 class="text-success">S/. @cita?.MontoPagado.ToString("N2")</h4>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">Saldo Pendiente</small>
                            @{
                                var pendiente = (cita?.MontoTotal ?? 0) - (cita?.MontoPagado ?? 0);
                            }
                            <h4 class="@(pendiente > 0 ? "text-danger" : "text-success")">S/. @pendiente.ToString("N2")</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lista de Pagos -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-credit-card"></i> Pagos Realizados (@(pagos?.Count ?? 0))</h5>
                </div>
                <div class="card-body">
                    @if (pagos != null && pagos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Referencia</th>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Método</th>
                                        <th class="text-end">Monto</th>
                                        <th class="text-center">PDF</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pago in pagos)
                                    {
                                        <tr>
                                            <td><code>@pago.Referencia</code></td>
                                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @{
                                                    var tipoBadge = pago.TipoPago switch
                                                    {
                                                        "Completo" => "bg-success",
                                                        "Parcial" => "bg-warning text-dark",
                                                        "Restante" => "bg-info",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @tipoBadge">@pago.TipoPago</span>
                                            </td>
                                            <td>
                                                @if (pago.MetodoPago == "Tarjeta")
                                                {
                                                    <i class="bi bi-credit-card text-primary"></i>
                                                    <span>****@pago.UltimosDigitosTarjeta</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cash text-success"></i>
                                                    <span>Efectivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <strong class="text-success">S/. @pago.Monto.ToString("N2")</strong>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="PagoCita" asp-action="DescargarComprobante" asp-route-pagoId="@pago.Id" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-file-pdf"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <td colspan="4" class="text-end"><strong>Total Pagado:</strong></td>
                                        <td class="text-end"><strong class="text-success">S/. @pagos.Sum(p => p.Monto).ToString("N2")</strong></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-4 text-muted"></i>
                            <p class="text-muted mt-2">No hay pagos registrados para esta cita.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
