@model Veterinaria.Web.Models.Dto.PagoDto
@{
    ViewData["Title"] = "Detalle de Pago";
}

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Detalle de la transacción financiera</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
        <!-- Información del Pago -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
            <div class="bg-secondary p-md text-on-secondary flex justify-between items-center">
                <h5 class="font-headline-sm text-headline-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">receipt_long</span> Información del Pago
                </h5>
            </div>
            <div class="p-lg">
                <div class="space-y-4 text-sm">
                    <div class="flex justify-between items-center border-b border-outline-variant pb-2">
                        <span class="text-on-surface-variant">Referencia</span>
                        <code class="bg-surface-variant px-2 py-1 rounded font-mono text-on-surface-variant">@Model.Referencia</code>
                    </div>
                    <div class="flex justify-between items-center border-b border-outline-variant pb-2">
                        <span class="text-on-surface-variant">Tipo de Pago</span>
                        @{
                            var tipoBadge = Model.TipoPago switch
                            {
                                "Completo" => "bg-secondary-container text-on-secondary-container",
                                "Parcial" => "bg-tertiary-container text-on-tertiary-container",
                                "Restante" => "bg-primary-container text-on-primary-container",
                                _ => "bg-surface-variant text-on-surface"
                            };
                        }
                        <span class="px-2 py-0.5 rounded-full font-label-sm text-label-sm @tipoBadge">@Model.TipoPago</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-outline-variant pb-2">
                        <span class="text-on-surface-variant">Método de Pago</span>
                        <span class="flex items-center gap-1 font-semibold text-on-surface">
                            @if (Model.MetodoPago == "Tarjeta")
                            {
                                <span class="material-symbols-outlined text-primary text-sm">credit_card</span>
                                <span>Tarjeta</span>
                                @if (!string.IsNullOrEmpty(Model.UltimosDigitosTarjeta))
                                {
                                    <span class="text-on-surface-variant font-normal">(**** @Model.UltimosDigitosTarjeta)</span>
                                }
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-secondary text-sm">payments</span>
                                <span>Efectivo</span>
                            }
                        </span>
                    </div>
                    <div class="flex justify-between items-center border-b border-outline-variant pb-2">
                        <span class="text-on-surface-variant">Fecha de Pago</span>
                        <div class="text-right">
                            <span class="font-semibold block text-on-surface">@Model.FechaPago.ToString("dd 'de' MMMM yyyy")</span>
                            <span class="text-xs text-on-surface-variant">@Model.FechaPago.ToString("HH:mm:ss")</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center pt-2">
                        <span class="text-on-surface-variant font-semibold">Monto</span>
                        <span class="font-headline-md text-headline-md text-secondary">S/. @Model.Monto.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de la Cita -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col justify-between">
            <div>
                <div class="bg-primary p-md text-on-primary flex justify-between items-center border-b border-outline-variant">
                    <h5 class="font-headline-sm text-headline-sm flex items-center gap-2">
                        <span class="material-symbols-outlined">calendar_check</span> Cita Asociada
                    </h5>
                </div>
                <div class="p-lg">
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center">
                            <span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">pets</span> Mascota</span>
                            <strong class="text-on-surface">@Model.MascotaNombre</strong>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">person</span> Propietario</span>
                            <span class="text-on-surface">@Model.PropietarioNombre</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">medical_information</span> Veterinario</span>
                            <span class="text-on-surface">@Model.VeterinarioNombre</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">healing</span> Servicio</span>
                            <span class="bg-surface-variant px-2 py-0.5 rounded font-label-sm text-label-sm text-on-surface">@Model.ServicioNombre</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-outline-variant pb-4">
                            <span class="text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-sm">event</span> Fecha Cita</span>
                            <span class="text-on-surface">@(Model.FechaCita?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                        </div>

                        <!-- Estado del pago de la cita -->
                        <div class="grid grid-cols-3 gap-2 pt-2 text-center">
                            <div class="bg-surface-container p-2 rounded-lg">
                                <span class="text-xs text-on-surface-variant block uppercase tracking-wider mb-1">Total Cita</span>
                                <strong class="text-on-surface">S/. @(((decimal)(ViewBag.MontoTotalCita ?? 0m)).ToString("N2"))</strong>
                            </div>
                            <div class="bg-surface-container p-2 rounded-lg">
                                <span class="text-xs text-on-surface-variant block uppercase tracking-wider mb-1">Pagado</span>
                                <strong class="text-secondary">S/. @(((decimal)(ViewBag.MontoPagadoCita ?? 0m)).ToString("N2"))</strong>
                            </div>
                            <div class="bg-surface-container p-2 rounded-lg">
                                <span class="text-xs text-on-surface-variant block uppercase tracking-wider mb-1">Pendiente</span>
                                @{
                                    var pendiente = ((decimal)(ViewBag.MontoTotalCita ?? 0m)) - ((decimal)(ViewBag.MontoPagadoCita ?? 0m));
                                }
                                <strong class="@(pendiente > 0 ? "text-error" : "text-secondary")">S/. @pendiente.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="p-md bg-surface-container-low border-t border-outline-variant flex gap-2">
                <a asp-controller="PagoCita" asp-action="DescargarComprobante" asp-route-pagoId="@Model.Id" class="flex-1 flex items-center justify-center gap-2 bg-surface text-error border border-outline-variant px-3 py-2 rounded-md hover:bg-error-container transition-colors text-sm font-semibold">
                    <span class="material-symbols-outlined text-sm">picture_as_pdf</span> Comprobante
                </a>
                <a asp-controller="Citas" asp-action="Details" asp-route-id="@Model.CitaId" class="flex-1 flex items-center justify-center gap-2 bg-primary text-on-primary px-3 py-2 rounded-md hover:bg-primary/90 transition-colors text-sm font-semibold">
                    <span class="material-symbols-outlined text-sm">calendar_month</span> Ver Cita
                </a>
            </div>
        </div>
    </div>
</div>
