@model List<Veterinaria.Domain.Entities.Cita>
@{
    ViewData["Title"] = "Pagos Pendientes";
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Citas atendidas con saldo parcial a pagar.</p>
    </div>
    <a asp-action="Index" class="flex items-center gap-1 text-primary hover:underline font-label-md text-label-md">
        <span class="material-symbols-outlined text-sm">arrow_back</span> Volver a Pagos
    </a>
</div>

<div class="bg-tertiary-container/30 border border-tertiary text-on-surface p-4 rounded-xl mb-lg flex gap-3 items-start">
    <span class="material-symbols-outlined text-tertiary text-xl mt-0.5">info</span>
    <p class="text-sm">Estas son citas que fueron atendidas pero tienen un pago parcial. El cliente debe completar el pago restante para finalizar el proceso.</p>
</div>

<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden mb-lg">
    <div class="bg-surface-container-low p-md border-b border-outline-variant flex items-center gap-2">
        <span class="material-symbols-outlined text-tertiary">warning</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface">Citas con Pago Pendiente</h3>
    </div>
    
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-container-lowest border-b border-outline-variant">
                    <tr>
                        <th class="p-4 font-semibold text-on-surface">Cita / Fecha</th>
                        <th class="p-4 font-semibold text-on-surface">Paciente / Propietario</th>
                        <th class="p-4 font-semibold text-on-surface">Servicio</th>
                        <th class="p-4 font-semibold text-on-surface text-right">Pagado</th>
                        <th class="p-4 font-semibold text-on-surface text-right">Pendiente</th>
                        <th class="p-4 font-semibold text-on-surface text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var cita in Model)
                    {
                        var pendiente = cita.MontoTotal - cita.MontoPagado;
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4">
                                <span class="font-mono bg-surface-variant px-1.5 py-0.5 rounded text-xs mb-1 inline-block">#@cita.Id</span>
                                <span class="block text-on-surface-variant">@cita.FechaHora.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="p-4">
                                <strong class="block text-on-surface flex items-center gap-1"><span class="material-symbols-outlined text-xs">pets</span> @cita.Mascota?.Nombre</strong>
                                <span class="text-xs text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[10px]">person</span> @cita.Mascota?.Usuario?.Nombre</span>
                            </td>
                            <td class="p-4"><span class="bg-surface-container px-2 py-1 rounded font-label-sm">@cita.Servicio?.Nombre</span></td>
                            <td class="p-4 text-right text-secondary font-semibold">S/. @cita.MontoPagado.ToString("N2")</td>
                            <td class="p-4 text-right text-error font-bold">S/. @pendiente.ToString("N2")</td>
                            <td class="p-4 text-center">
                                <a asp-controller="PagoCita" asp-action="CompletarPago" asp-route-citaId="@cita.Id" class="inline-flex items-center gap-1 bg-tertiary text-on-tertiary px-3 py-1.5 rounded-full font-label-md text-label-md hover:opacity-90 transition-colors shadow-sm">
                                    <span class="material-symbols-outlined text-sm">payments</span> Completar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-surface-container">
                    <tr>
                        <td colspan="4" class="p-4 text-right font-semibold text-on-surface uppercase tracking-wider text-xs">Total Pendiente Acumulado:</td>
                        <td class="p-4 text-right text-error font-headline-sm text-headline-sm">
                            S/. @Model.Sum(c => c.MontoTotal - c.MontoPagado).ToString("N2")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center p-xl text-on-surface-variant">
            <span class="material-symbols-outlined text-6xl mb-sm text-secondary">check_circle</span>
            <h4 class="font-headline-md text-headline-md text-on-surface mb-1">¡Excelente!</h4>
            <p>No hay citas con pagos pendientes. Todos los saldos están saldados.</p>
        </div>
    }
</div>
