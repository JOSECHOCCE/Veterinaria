@{
    ViewData["Title"] = "Voucher de Pago";
    var cita = ViewBag.Cita as Veterinaria.Domain.Entities.Cita;
    var montoRestante = (decimal)ViewBag.MontoRestante;
    var montoPagado = (decimal)ViewBag.MontoPagado;
    var montoTotal = (decimal)ViewBag.MontoTotal;
    var referencia = (string)ViewBag.Referencia;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Voucher -->
            <div class="card shadow-lg border-warning">
                <div class="card-header bg-warning text-dark text-center py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-receipt-cutoff me-2"></i>Voucher de Pago
                    </h4>
                    <small>Referencia: @referencia</small>
                </div>
                
                <div class="card-body">
                    <!-- Mensaje Principal -->
                    <div class="alert alert-warning border-warning mb-4">
                        <div class="text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 mb-2 d-block"></i>
                            <h5 class="mb-2 fw-bold">ACÉRQUESE A CAJA PARA COMPLETAR SU PAGO</h5>
                            <p class="mb-0 fw-bold">PARA PASAR A RECOGER A SU MASCOTA</p>
                        </div>
                    </div>

                    <!-- Datos de la Cita -->
                    <div class="mb-4">
                        <h6 class="text-muted border-bottom pb-2">
                            <i class="bi bi-info-circle me-1"></i>Datos de la Cita
                        </h6>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1"><strong>Mascota:</strong></p>
                                <p class="text-primary fw-bold">@cita?.Mascota?.Nombre</p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1"><strong>Servicio:</strong></p>
                                <p>@cita?.Servicio?.Nombre</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1"><strong>Fecha Atención:</strong></p>
                                <p>@cita?.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1"><strong>Estado:</strong></p>
                                <span class="badge bg-success">Completada ✓</span>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen de Pagos -->
                    <div class="mb-4">
                        <h6 class="text-muted border-bottom pb-2">
                            <i class="bi bi-cash-stack me-1"></i>Resumen de Pagos
                        </h6>
                        <table class="table table-sm mb-0">
                            <tr>
                                <td>Total del Servicio:</td>
                                <td class="text-end fw-bold">S/. @montoTotal.ToString("N2")</td>
                            </tr>
                            <tr class="text-success">
                                <td><i class="bi bi-credit-card me-1"></i>Pagado con Tarjeta:</td>
                                <td class="text-end fw-bold">S/. @montoPagado.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Monto a Pagar en Caja - DESTACADO -->
                    <div class="bg-danger text-white rounded p-4 text-center mb-4">
                        <p class="mb-1 fs-6">MONTO A PAGAR EN CAJA</p>
                        <p class="mb-0 small">(Pago en Efectivo)</p>
                        <h2 class="mb-0 display-5 fw-bold">S/. @montoRestante.ToString("N2")</h2>
                    </div>

                    <!-- Acciones -->
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("DescargarVoucherEfectivo", new { citaId = cita?.Id, montoRestante, montoPagado, montoTotal, referencia })" 
                           class="btn btn-warning btn-lg">
                            <i class="bi bi-download me-2"></i>Descargar Voucher PDF
                        </a>
                        <a asp-action="Details" asp-controller="Citas" asp-route-id="@cita?.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Volver a la Cita
                        </a>
                    </div>

                    <!-- Nota -->
                    <div class="mt-4 text-center">
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            Voucher generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                        <br>
                        <small class="text-muted fst-italic">
                            Válido solo para el día de hoy
                        </small>
                    </div>
                </div>
            </div>

            <!-- Instrucciones -->
            <div class="card mt-4 border-info">
                <div class="card-body">
                    <h6 class="card-title text-info">
                        <i class="bi bi-info-circle me-1"></i>Instrucciones
                    </h6>
                    <ol class="mb-0 small">
                        <li>Descargue o imprima este voucher</li>
                        <li>Diríjase a la caja de la clínica</li>
                        <li>Presente el voucher y realice el pago de <strong>S/. @montoRestante.ToString("N2")</strong></li>
                        <li>Una vez completado el pago, podrá recoger a su mascota</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>
