@model Veterinaria.Domain.Entities.Usuario
@{
    ViewData["Title"] = $"Cliente: {Model.Nombre}";
    var citas = ViewBag.Citas as List<Veterinaria.Domain.Entities.Cita> ?? new List<Veterinaria.Domain.Entities.Cita>();
}

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-lg">
        <p class="font-body-md text-body-md text-on-surface-variant">Perfil detallado del cliente</p>
        <a asp-action="Index" class="text-primary hover:underline font-label-md text-label-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Volver a Clientes
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-md">
        <!-- Columna Izquierda: Perfil y Stats -->
        <div class="lg:col-span-1 space-y-md">
            
            <!-- Info Cliente -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-primary-container p-md text-on-primary-container flex justify-between items-center border-b border-outline-variant">
                    <h5 class="font-headline-sm text-headline-sm flex items-center gap-2"><span class="material-symbols-outlined">person</span> Perfil</h5>
                </div>
                <div class="p-lg text-center">
                    <div class="w-20 h-20 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-xl text-headline-xl mx-auto mb-4 font-bold">
                        @Model.Nombre.Substring(0, 1).ToUpper()
                    </div>
                    <h4 class="font-headline-md text-headline-md text-on-surface">@Model.Nombre</h4>
                    <div class="mt-2 mb-4">
                        @if (Model.Activo)
                        {
                            <span class="bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full text-xs font-semibold inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm">check_circle</span> Activo</span>
                        }
                        else
                        {
                            <span class="bg-surface-variant text-on-surface-variant px-3 py-1 rounded-full text-xs font-semibold inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm">cancel</span> Inactivo</span>
                        }
                    </div>
                    <div class="text-left space-y-3 text-sm text-on-surface pt-4 border-t border-outline-variant">
                        <p class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-lg">mail</span> @Model.Email</p>
                        @if (!string.IsNullOrEmpty(Model.Telefono)) { <p class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-lg">call</span> @Model.Telefono</p> }
                        @if (!string.IsNullOrEmpty(Model.Direccion)) { <p class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-lg">location_on</span> @Model.Direccion</p> }
                        <p class="flex items-center gap-2 text-on-surface-variant mt-2 pt-2 border-t border-outline-variant"><span class="material-symbols-outlined text-lg">calendar_today</span> Registro: @Model.FechaRegistro.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-tertiary-container p-md text-on-tertiary-container flex justify-between items-center border-b border-outline-variant">
                    <h5 class="font-headline-sm text-headline-sm flex items-center gap-2"><span class="material-symbols-outlined">monitoring</span> Actividad</h5>
                </div>
                <div class="p-md">
                    <div class="grid grid-cols-2 gap-4 text-center mb-6">
                        <div class="bg-surface-container p-3 rounded-lg">
                            <h3 class="font-headline-lg text-primary">@ViewBag.TotalCitas</h3>
                            <span class="text-xs text-on-surface-variant uppercase">Total Citas</span>
                        </div>
                        <div class="bg-surface-container p-3 rounded-lg">
                            <h3 class="font-headline-lg text-secondary">@ViewBag.CitasCompletadas</h3>
                            <span class="text-xs text-on-surface-variant uppercase">Completadas</span>
                        </div>
                        <div class="bg-surface-container p-3 rounded-lg">
                            <h3 class="font-headline-lg text-tertiary">@ViewBag.CitasPendientes</h3>
                            <span class="text-xs text-on-surface-variant uppercase">Pendientes</span>
                        </div>
                        <div class="bg-surface-container p-3 rounded-lg">
                            <h3 class="font-headline-lg text-error">@ViewBag.CitasCanceladas</h3>
                            <span class="text-xs text-on-surface-variant uppercase">Canceladas</span>
                        </div>
                    </div>
                    <div class="text-center pt-4 border-t border-outline-variant">
                        <p class="text-xs text-on-surface-variant uppercase mb-1">Total Gastado</p>
                        <h4 class="font-headline-md text-secondary">@(((decimal)ViewBag.TotalGastado).ToString("C"))</h4>
                        @if ((decimal)ViewBag.PagosPendientes > 0)
                        {
                            <p class="text-xs text-tertiary mt-1 bg-tertiary-container/30 inline-block px-2 py-1 rounded">Pendiente: @(((decimal)ViewBag.PagosPendientes).ToString("C"))</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Mascotas y Citas -->
        <div class="lg:col-span-2 space-y-md">
            
            <!-- Mascotas -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-surface-container-low p-md border-b border-outline-variant flex justify-between items-center">
                    <h5 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2"><span class="material-symbols-outlined text-primary">pets</span> Mascotas (@Model.Mascotas.Count)</h5>
                </div>
                <div class="p-md">
                    @if (!Model.Mascotas.Any())
                    {
                        <div class="text-center py-6 text-on-surface-variant">
                            <span class="material-symbols-outlined text-4xl mb-2 opacity-50">sentiment_dissatisfied</span>
                            <p>No tiene mascotas registradas</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var mascota in Model.Mascotas)
                            {
                                <a href="@Url.Action("Details", "Mascotas", new { id = mascota.Id })" class="flex items-center gap-4 p-4 rounded-lg border border-outline-variant hover:border-primary hover:bg-surface-container-low transition-colors text-decoration-none group @(!mascota.Activo ? "opacity-60 bg-surface-container" : "")">
                                    <div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center group-hover:bg-primary/10 transition-colors">
                                        @if (mascota.Especie?.ToLower() == "perro") { <span class="material-symbols-outlined text-tertiary text-2xl">cruelty_free</span> }
                                        else if (mascota.Especie?.ToLower() == "gato") { <span class="material-symbols-outlined text-primary text-2xl">pest_control_rodent</span> } <!-- Alternativa visual -->
                                        else { <span class="material-symbols-outlined text-secondary text-2xl">pets</span> }
                                    </div>
                                    <div>
                                        <h6 class="font-headline-sm text-on-surface flex items-center gap-2">
                                            @mascota.Nombre
                                            @if (!mascota.Activo) { <span class="text-[10px] bg-surface-variant px-1.5 py-0.5 rounded">Inactivo</span> }
                                        </h6>
                                        <p class="text-xs text-on-surface-variant">@mascota.Especie - @mascota.Raza</p>
                                    </div>
                                    <span class="material-symbols-outlined ml-auto text-on-surface-variant group-hover:text-primary">chevron_right</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Citas -->
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="bg-surface-container-low p-md border-b border-outline-variant flex justify-between items-center">
                    <h5 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2"><span class="material-symbols-outlined text-primary">calendar_month</span> Últimas Citas</h5>
                    <a asp-controller="Citas" asp-action="Index" asp-route-buscar="@Model.Nombre" class="text-xs font-semibold text-primary hover:underline">Ver todas</a>
                </div>
                <div>
                    @if (!citas.Any())
                    {
                        <div class="text-center py-6 text-on-surface-variant">
                            <span class="material-symbols-outlined text-4xl mb-2 opacity-50">event_busy</span>
                            <p>No tiene citas registradas</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-surface-container-lowest border-b border-outline-variant">
                                    <tr>
                                        <th class="p-3 font-semibold text-on-surface">Fecha</th>
                                        <th class="p-3 font-semibold text-on-surface">Mascota</th>
                                        <th class="p-3 font-semibold text-on-surface">Servicio</th>
                                        <th class="p-3 font-semibold text-on-surface">Estado</th>
                                        <th class="p-3 text-center"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant">
                                    @foreach (var cita in citas)
                                    {
                                        var badgeC = cita.Estado switch {
                                            "Pendiente" => "bg-surface-variant text-on-surface",
                                            "Confirmada" => "bg-primary-container text-on-primary-container",
                                            "EnProceso" => "bg-tertiary-container text-on-tertiary-container",
                                            "Completada" => "bg-secondary-container text-on-secondary-container",
                                            "Cancelada" => "bg-error-container text-on-error-container",
                                            _ => "bg-surface-container text-on-surface"
                                        };
                                        <tr class="hover:bg-surface-container-low transition-colors">
                                            <td class="p-3">
                                                <span class="font-semibold block">@cita.FechaHora.ToString("dd/MM/yyyy")</span>
                                                <span class="text-xs text-on-surface-variant">@cita.FechaHora.ToString("HH:mm")</span>
                                            </td>
                                            <td class="p-3">@cita.Mascota?.Nombre</td>
                                            <td class="p-3">@cita.Servicio?.Nombre</td>
                                            <td class="p-3"><span class="px-2 py-1 rounded-full text-xs font-semibold @badgeC">@cita.Estado</span></td>
                                            <td class="p-3 text-right">
                                                <a asp-controller="Citas" asp-action="Details" asp-route-id="@cita.Id" class="inline-flex p-1.5 text-primary hover:bg-primary-container rounded-full transition-colors"><span class="material-symbols-outlined text-lg">visibility</span></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            
        </div>
    </div>
</div>
