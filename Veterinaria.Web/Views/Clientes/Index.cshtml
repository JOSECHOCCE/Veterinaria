@model X.PagedList.IPagedList<Veterinaria.Domain.Entities.Usuario>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Clientes";
    var citasPorUsuario = ViewBag.CitasPorUsuario as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-lg">
    <div>
        <p class="font-body-md text-body-md text-on-surface-variant">Gestión de base de datos de clientes y propietarios</p>
    </div>
    <div class="bg-primary-container text-on-primary-container px-md py-sm rounded-full font-label-md text-label-md shadow-sm">
        @Model.TotalItemCount clientes registrados
    </div>
</div>

<!-- Filtros -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm mb-lg p-md">
    <form method="get" class="flex flex-col md:flex-row gap-md items-end">
        <div class="flex-1 w-full">
            <label class="block font-label-md text-label-md text-on-surface mb-xs">Buscar cliente</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input type="text" name="buscar" class="w-full bg-surface border border-outline-variant rounded-md pl-10 pr-3 py-2 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Buscar por nombre, email o teléfono..." value="@ViewBag.BuscarActual" />
            </div>
        </div>
        <div class="w-full md:w-auto flex items-center mb-2 md:mb-0 h-[42px]">
            <label class="flex items-center gap-2 cursor-pointer text-on-surface hover:text-primary transition-colors">
                <input type="checkbox" name="mostrarInactivos" value="true" class="w-4 h-4 text-primary bg-surface border-outline-variant focus:ring-primary rounded" @(ViewBag.MostrarInactivos ? "checked" : "") />
                <span class="font-label-md text-label-md">Mostrar inactivos</span>
            </label>
        </div>
        <div class="w-full md:w-auto flex gap-2">
            <button type="submit" class="flex-1 md:flex-none bg-surface-variant text-on-surface px-xl py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-high transition-colors">Buscar</button>
            <a asp-action="Index" class="flex-1 md:flex-none bg-surface text-on-surface border border-outline-variant px-md py-2 rounded-md font-label-md text-label-md hover:bg-surface-container-low transition-colors text-center">Limpiar</a>
        </div>
    </form>
</div>

<!-- Tabla de Clientes -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden mb-lg">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant">
                    <th class="p-4 font-label-md text-label-md text-on-surface">Cliente</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface">Contacto</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-center">Mascotas</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-center">Citas</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface">Registro</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-center">Estado</th>
                    <th class="p-4 font-label-md text-label-md text-on-surface text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="p-xl text-center text-on-surface-variant">
                            <span class="material-symbols-outlined text-6xl mb-sm opacity-50 block">group_off</span>
                            <p class="font-headline-md text-headline-md">No se encontraron clientes</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var usuario in Model)
                    {
                        var totalCitas = citasPorUsuario.ContainsKey(usuario.Id) ? citasPorUsuario[usuario.Id] : 0;
                        <tr class="hover:bg-surface-container-low transition-colors @(!usuario.Activo ? "opacity-60 bg-surface-container" : "")">
                            <td class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-md font-semibold">
                                        @usuario.Nombre.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-body-md text-body-md text-on-surface font-semibold flex items-center gap-2">
                                            @usuario.Nombre
                                            @if (!usuario.Activo)
                                            {
                                                <span class="font-label-sm text-label-sm bg-surface-variant text-on-surface-variant px-2 py-0.5 rounded-full">Inactivo</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="text-sm text-on-surface-variant flex flex-col gap-1">
                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">mail</span> @usuario.Email</span>
                                    @if (!string.IsNullOrEmpty(usuario.Telefono))
                                    {
                                        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">call</span> @usuario.Telefono</span>
                                    }
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                <span class="font-label-sm text-label-sm text-on-secondary-container bg-secondary-container px-3 py-1 rounded-full">@usuario.Mascotas.Count</span>
                            </td>
                            <td class="p-4 text-center">
                                <span class="font-label-sm text-label-sm text-on-primary-container bg-primary-container px-3 py-1 rounded-full">@totalCitas</span>
                            </td>
                            <td class="p-4 font-body-sm text-body-sm text-on-surface-variant">
                                @usuario.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>
                            <td class="p-4 text-center">
                                @if (usuario.Activo)
                                {
                                    <span class="font-label-sm text-label-sm text-on-secondary-container bg-secondary-container px-3 py-1 rounded-full inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="font-label-sm text-label-sm text-on-surface bg-surface-variant px-3 py-1 rounded-full inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">cancel</span> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@usuario.Id" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors inline-flex" title="Ver detalles">
                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                    </a>
                                    <form asp-action="ToggleActivo" asp-route-id="@usuario.Id" method="post" class="inline-flex m-0 p-0">
                                        @if (usuario.Activo)
                                        {
                                            <button type="submit" class="text-tertiary hover:bg-tertiary-container p-2 rounded-full transition-colors" title="Desactivar" onclick="return confirm('¿Desactivar este cliente?')">
                                                <span class="material-symbols-outlined text-lg">pause_circle</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="text-secondary hover:bg-secondary-container p-2 rounded-full transition-colors" title="Activar">
                                                <span class="material-symbols-outlined text-lg">play_circle</span>
                                            </button>
                                        }
                                    </form>
                                    <button type="button" class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Eliminar" onclick="document.getElementById('modal-@usuario.Id').classList.remove('hidden')">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </div>

                                <!-- Modal Eliminación (Custom Tailwind) -->
                                <div id="modal-@usuario.Id" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/50 backdrop-blur-sm">
                                    <div class="bg-surface rounded-xl shadow-lg max-w-md w-full overflow-hidden text-left border border-outline-variant">
                                        <div class="bg-error p-4 text-on-error flex justify-between items-center">
                                            <h5 class="font-headline-sm text-headline-sm flex items-center gap-2">
                                                <span class="material-symbols-outlined">warning</span> Confirmar Eliminación
                                            </h5>
                                            <button type="button" onclick="document.getElementById('modal-@usuario.Id').classList.add('hidden')" class="hover:bg-error-container/20 p-1 rounded-full text-on-error">
                                                <span class="material-symbols-outlined">close</span>
                                            </button>
                                        </div>
                                        <div class="p-lg space-y-4">
                                            <div class="bg-error-container text-on-error-container p-3 rounded-md border border-error">
                                                <strong class="flex items-center gap-1 mb-1"><span class="material-symbols-outlined text-sm">dangerous</span> ¡Atención!</strong>
                                                <p class="text-sm">Esta acción es irreversible y eliminará permanentemente al cliente y todos sus registros (Mascotas, Citas, Pagos, Historiales).</p>
                                            </div>
                                            <p class="font-body-md text-body-md text-on-surface">¿Está seguro de que desea eliminar a <strong>@usuario.Nombre</strong>?</p>
                                        </div>
                                        <div class="p-4 bg-surface-container-low border-t border-outline-variant flex justify-end gap-3">
                                            <button type="button" onclick="document.getElementById('modal-@usuario.Id').classList.add('hidden')" class="px-md py-sm rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-colors">
                                                Cancelar
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@usuario.Id" method="post" class="m-0 p-0">
                                                <button type="submit" class="bg-error text-on-error px-md py-sm rounded-full font-label-md text-label-md hover:bg-error/90 transition-colors shadow-sm flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-sm">delete_forever</span> Sí, Eliminar Todo
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Paginación -->
@if (Model.PageCount > 1)
{
    <div class="bg-surface-container-lowest p-md border border-outline-variant rounded-xl shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="text-sm text-on-surface-variant">
            Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount clientes
        </div>
        <div>
            <style>
                .pagination { display: flex; list-style: none; gap: 4px; margin: 0; padding: 0; }
                .page-item .page-link { padding: 4px 12px; border-radius: 4px; border: 1px solid #c3c6d5; color: #071e27; text-decoration: none; font-size: 14px; background: #f3faff; }
                .page-item.active .page-link { background: #003c90; color: #ffffff; border-color: #003c90; }
                .page-item.disabled .page-link { opacity: 0.5; pointer-events: none; }
                .page-item:not(.active):not(.disabled) .page-link:hover { background: #cfe6f2; }
            </style>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { 
                page, 
                buscar = ViewBag.BuscarActual,
                mostrarInactivos = ViewBag.MostrarInactivos
            }), new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
        </div>
    </div>
}
