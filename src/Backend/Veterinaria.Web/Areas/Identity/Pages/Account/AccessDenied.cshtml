@page
@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-shield-x me-2"></i>@ViewData["Title"]</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                </div>
                <h5 class="text-danger">No tiene permisos para acceder a esta página</h5>
                <p class="text-muted mb-4">
                    Su cuenta no tiene los privilegios necesarios para ver este contenido.
                    Contacte al administrador si cree que debería tener acceso.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-2"></i>Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
